    def __init__(self, bus: dbus.Bus, send_fn) -> None:
        super().__init__(bus, NOTIF_OBJ_PATH)
        self.send_fn = send_fn

    @dbus.service.method(NOTIF_IFACE, in_signature="", out_signature="as")
    def GetCapabilities(self) -> dbus.Array:
        return dbus.Array(["body", "body-markup", "icon-static"], signature="s")

    @dbus.service.method(NOTIF_IFACE, in_signature="", out_signature="ssss")
    def GetServerInformation(self):
        return (
            dbus.String("wayport Host Notification Bridge"),
            dbus.String("KDE"),
            dbus.String("6.0"),
            dbus.String("1.2"),
        )

    @dbus.service.method(NOTIF_IFACE, in_signature="susssasa{sv}i", out_signature="u")
    def Notify(
        self,
        app_name: str,
        replaces_id: int,
        app_icon: str,
        summary: str,
        body: str,
        actions: list,
        hints: dict,
        expire_timeout: int,
    ) -> dbus.UInt32:
        if replaces_id and int(replaces_id) > 0:
            nid = int(replaces_id)
        else:
            EmbeddedNotificationsBridge._notif_id += 1
            nid = EmbeddedNotificationsBridge._notif_id

        self.send_fn({
            "event": "notify",
            "id": nid,
            "app_name": str(app_name or "VM App"),
            "app_icon": str(app_icon or ""),
            "summary": str(summary or ""),
            "body": str(body or ""),
            "timeout": int(expire_timeout),
        })
        return dbus.UInt32(nid)

    @dbus.service.method(NOTIF_IFACE, in_signature="u", out_signature="")
    def CloseNotification(self, nid: int) -> None:
        self.NotificationClosed(dbus.UInt32(nid), dbus.UInt32(3))

    @dbus.service.signal(NOTIF_IFACE, signature="uu")
    def NotificationClosed(self, nid: int, reason: int) -> None:
        pass

    @dbus.service.signal(NOTIF_IFACE, signature="us")
    def ActionInvoked(self, nid: int, action_key: str) -> None:
        pass


class EmbeddedStatusNotifierWatcher(dbus.service.Object):
    def __init__(self, bus: dbus.Bus, agent) -> None:
        super().__init__(bus, SNW_OBJ_PATH)
        self.bus = bus
        self.agent = agent
        self.registered_items: dict[str, str] = {}

    @dbus.service.method(SNW_IFACE, in_signature="s", out_signature="", sender_keyword="sender")
    def RegisterStatusNotifierItem(self, service: str, sender: str = "") -> None:
        service = str(service)
        if service.startswith("/"):
            bus_name = str(sender)
            obj_path = service
        elif "/" in service:
            bus_name, rest = service.split("/", 1)
            obj_path = "/" + rest
        else:
            bus_name = service
            obj_path = "/StatusNotifierItem"

        owner = self.agent.resolve_unique_owner(bus_name)
        item_str = f"{owner}{obj_path}"
        self.registered_items[item_str] = owner
        self.StatusNotifierItemRegistered(item_str)
        self.agent.on_item_registered(item_str)

    @dbus.service.method(SNW_IFACE, in_signature="s", out_signature="")
    def RegisterStatusNotifierHost(self, service: str) -> None:
        self.StatusNotifierHostRegistered()

    @dbus.service.method(PROPS_IFACE, in_signature="ss", out_signature="v")
    def Get(self, interface_name: str, property_name: str):
        return self.GetAll(interface_name).get(property_name, dbus.String("", variant_level=1))

    @dbus.service.method(PROPS_IFACE, in_signature="s", out_signature="a{sv}")
    def GetAll(self, interface_name: str) -> dbus.Dictionary:
        if interface_name == SNW_IFACE:
            return dbus.Dictionary(
                {
                    "RegisteredStatusNotifierItems": dbus.Array(
                        [dbus.String(k) for k in self.registered_items.keys()],
                        signature="s",
                        variant_level=1,
                    ),
                    "IsStatusNotifierHostRegistered": dbus.Boolean(True, variant_level=1),
                    "ProtocolVersion": dbus.Int32(0, variant_level=1),
                },
                signature="sv",
            )
        return dbus.Dictionary({}, signature="sv")

    @dbus.service.signal(SNW_IFACE, signature="s")
    def StatusNotifierItemRegistered(self, service: str) -> None:
        pass

    @dbus.service.signal(SNW_IFACE, signature="s")
    def StatusNotifierItemUnregistered(self, service: str) -> None:
        pass

    @dbus.service.signal(SNW_IFACE, signature="")
    def StatusNotifierHostRegistered(self) -> None:
        pass

    @dbus.service.signal(SNW_IFACE, signature="")
    def StatusNotifierHostUnregistered(self) -> None:
        pass

    def remove_by_owner(self, lost_owner: str) -> None:
        for item_str, owner in list(self.registered_items.items()):
            if owner == lost_owner:
                del self.registered_items[item_str]
                self.StatusNotifierItemUnregistered(item_str)


class GuestTrayAgent:
    def __init__(self, send_fn) -> None:
        self.send_fn = send_fn
        self.bus = dbus.SessionBus()
        self.items: dict[str, dict] = {}
        self.signal_matches: dict[str, list] = {}
        self.icon_cache: dict[str, tuple[tuple[str, str, float], str, list[dict]]] = {}
        self.last_menu_event_ts: dict[str, float] = {}

        self.embedded_watcher: EmbeddedStatusNotifierWatcher | None = None
        self.watcher_bus_name: dbus.service.BusName | None = None
        self.screensaver_obj: FastScreenSaverResponder | None = None
        self.screensaver_bus_name: dbus.service.BusName | None = None
        self.notif_obj: EmbeddedNotificationsBridge | None = None
        self.notif_bus_name: dbus.service.BusName | None = None

        self.host_bus_name_str = f"org.kde.StatusNotifierHost-{os.getpid()}"
        self.host_bus_name = dbus.service.BusName(self.host_bus_name_str, bus=self.bus)

        log_err(f"Connected to guest session D-Bus ({os.environ.get('DBUS_SESSION_BUS_ADDRESS')})")

        self.bus.add_signal_receiver(
            self.on_item_registered,
            signal_name="StatusNotifierItemRegistered",
            dbus_interface=SNW_IFACE,
        )
        self.bus.add_signal_receiver(
            self.on_item_unregistered,
            signal_name="StatusNotifierItemUnregistered",
            dbus_interface=SNW_IFACE,
        )
        self.bus.add_signal_receiver(
            self.on_name_owner_changed,
            signal_name="NameOwnerChanged",
            dbus_interface="org.freedesktop.DBus",
        )

        self.ensure_services_ready()
        self.scan_watcher_items()
        GLib.timeout_add(SCAN_INTERVAL_MS, self.scan_watcher_items)

    def ensure_services_ready(self) -> None:
        if self.notif_bus_name is None and not self.bus.name_has_owner(NOTIF_BUS_NAME):
            try:
                self.notif_bus_name = dbus.service.BusName(
                    NOTIF_BUS_NAME,
                    bus=self.bus,
                    allow_replacement=True,
                    replace_existing=True,
                )
                if self.notif_obj is None:
                    self.notif_obj = EmbeddedNotificationsBridge(self.bus, self.send_fn)
                log_err("Activated built-in org.freedesktop.Notifications bridge to host")
            except Exception as exc:
                log_err(f"Could not claim org.freedesktop.Notifications: {exc}")

        if self.screensaver_bus_name is None and not self.bus.name_has_owner(SCREENSAVER_BUS_NAME):
            try:
                self.screensaver_bus_name = dbus.service.BusName(
                    SCREENSAVER_BUS_NAME,
                    bus=self.bus,
                    allow_replacement=True,
                    replace_existing=False,
                )
                if self.screensaver_obj is None:
                    self.screensaver_obj = FastScreenSaverResponder(self.bus, SCREENSAVER_OBJ_PATH)
            except Exception:
                pass

        if self.watcher_bus_name is not None:
            return

        if not self.bus.name_has_owner(SNW_BUS_NAME):
            try:
                self.watcher_bus_name = dbus.service.BusName(
                    SNW_BUS_NAME,
                    bus=self.bus,
                    allow_replacement=True,
                    replace_existing=False,
                )
                if self.embedded_watcher is None:
                    self.embedded_watcher = EmbeddedStatusNotifierWatcher(self.bus, self)
                self.embedded_watcher.StatusNotifierHostRegistered()
                log_err("Headless VM mode: activated built-in org.kde.StatusNotifierWatcher")
                return
            except Exception as exc:
                log_err(f"Could not claim StatusNotifierWatcher: {exc}")

        try:
            snw_obj = self.bus.get_object(SNW_BUS_NAME, SNW_OBJ_PATH)
            dbus.Interface(snw_obj, SNW_IFACE).RegisterStatusNotifierHost(self.host_bus_name_str)
        except Exception:
            pass

    def split_item_service_and_path(self, item_str: str) -> tuple[str, str]:
        if "/" in item_str:
            bus_name, rest = item_str.split("/", 1)
            return bus_name, "/" + rest
        return item_str, "/StatusNotifierItem"

    def resolve_unique_owner(self, bus_name: str) -> str:
        if bus_name.startswith(":"):
            return bus_name
        try:
            dbus_obj = self.bus.get_object("org.freedesktop.DBus", "/org/freedesktop/DBus")
            return str(dbus.Interface(dbus_obj, "org.freedesktop.DBus").GetNameOwner(bus_name))
        except Exception:
            return bus_name

    def scan_watcher_items(self) -> bool:
        self.ensure_services_ready()

        if self.watcher_bus_name is not None and self.embedded_watcher is not None:
            registered = list(self.embedded_watcher.registered_items.keys())
        else:
            try:
                snw_obj = self.bus.get_object(SNW_BUS_NAME, SNW_OBJ_PATH)
                registered = dbus.Interface(snw_obj, PROPS_IFACE).Get(SNW_IFACE, "RegisteredStatusNotifierItems")
            except Exception:
                return True

        current_keys = set()
        for item_str in registered:
            bus_name, obj_path = self.split_item_service_and_path(str(item_str))
            owner = self.resolve_unique_owner(bus_name)
            key = f"{owner}{obj_path}"
            current_keys.add(key)
            if key not in self.items:
                self.try_register_item(key, bus_name, owner, obj_path)

        for old_key in list(self.items.keys()):
            if old_key not in current_keys:
                self.unregister_item(old_key)

        return True

    def on_item_registered(self, item_str: str) -> None:
        bus_name, obj_path = self.split_item_service_and_path(str(item_str))
        owner = self.resolve_unique_owner(bus_name)
        key = f"{owner}{obj_path}"
        if key not in self.items:
            self.try_register_item(key, bus_name, owner, obj_path)

    def on_item_unregistered(self, item_str: str) -> None:
        bus_name, obj_path = self.split_item_service_and_path(str(item_str))
        owner = self.resolve_unique_owner(bus_name)
        key = f"{owner}{obj_path}"
        self.unregister_item(key)

    def on_name_owner_changed(self, name: str, old_owner: str, new_owner: str) -> None:
        name_s = str(name)
        if name_s == SNW_BUS_NAME and not new_owner:
            self.watcher_bus_name = None
            self.ensure_services_ready()
            return
        if name_s == NOTIF_BUS_NAME and not new_owner:
            self.notif_bus_name = None
            self.ensure_services_ready()
            return
        if name_s == SCREENSAVER_BUS_NAME and not new_owner:
            self.screensaver_bus_name = None
            self.ensure_services_ready()
            return

        if old_owner and not new_owner:
            if self.embedded_watcher is not None:
                self.embedded_watcher.remove_by_owner(str(old_owner))
            for key, meta in list(self.items.items()):
                if meta["owner"] == old_owner or meta["bus_name"] == name_s:
                    self.unregister_item(key)

    def try_register_item(self, key: str, bus_name: str, owner: str, obj_path: str) -> None:
        state = self.fetch_sni_state(key, owner, obj_path, force_icons=True)
        if not state:
            return

        allowed, proc_info, pid, instance_id = inspect_guest_process(self.bus, owner, state.get("Id", ""))
        if not allowed:
            return

        log_err(f"Bridging guest tray item '{state.get('Title') or state.get('Id')}' from {proc_info} [{key}]")

        menu_path = state.get("MenuPath", "")
        menu_layout = self.fetch_menu_layout(owner, menu_path) if menu_path else None

        self.items[key] = {
            "bus_name": bus_name,
            "owner": owner,
            "obj_path": obj_path,
            "menu_path": menu_path,
            "pid": pid,
            "instance_id": instance_id,
        }

        matches = []
        icon_signals = {"NewIcon", "NewAttentionIcon", "NewOverlayIcon"}
        for sig_name in ("NewTitle", "NewIcon", "NewAttentionIcon", "NewOverlayIcon", "NewToolTip", "NewStatus"):
            is_icon = sig_name in icon_signals
            m = self.bus.add_signal_receiver(
                lambda *args, k=key, ic=is_icon: self.push_sni_update(k, refresh_icons=ic),
                signal_name=sig_name,
                dbus_interface=SNI_IFACE,
                bus_name=owner,
                path=obj_path,
            )
            matches.append(m)

        if menu_path:
            for menu_sig in ("LayoutUpdated", "ItemsPropertiesUpdated"):
                m = self.bus.add_signal_receiver(
                    lambda *args, k=key: self.push_menu_update(k),
                    signal_name=menu_sig,
                    dbus_interface=DBUSMENU_IFACE,
                    bus_name=owner,
                    path=menu_path,
                )
                matches.append(m)

        self.signal_matches[key] = matches
        self.send_fn({
            "event": "item_added",
            "key": key,
            "state": state,
            "menu": menu_layout,
        })

    def unregister_item(self, key: str) -> None:
        meta = self.items.pop(key, None)
        if not meta:
            return
        self.icon_cache.pop(key, None)
        last_click = self.last_menu_event_ts.pop(key, 0.0)
        for match in self.signal_matches.pop(key, []):
            try:
                match.remove()
            except Exception:
                pass
        self.send_fn({"event": "item_removed", "key": key})

        # Only trigger lingering-process watchdog if a tray menu item was clicked recently
        if last_click > 0 and (time.monotonic() - last_click) <= QUIT_WINDOW_SEC:
            pid = meta.get("pid", 0)
            instance_id = meta.get("instance_id", "")
            if pid > 1 or instance_id:
                threading.Thread(
                    target=terminate_lingering_instance,
                    args=(pid, instance_id),
                    daemon=True,
                ).start()

    def _get_icons_cached(
        self,
        key: str,
        icon_theme_path: str,
        icon_name: str,
        force_icons: bool,
    ) -> tuple[dict[str, str] | None, list[dict]]:
        mtime = 0.0
        if icon_theme_path:
            try:
                mtime = Path(icon_theme_path).stat().st_mtime
            except OSError:
                mtime = 0.0
        elif icon_name and os.path.isabs(icon_name):
            try:
                mtime = Path(icon_name).stat().st_mtime
            except OSError:
                mtime = 0.0

        sig = (icon_theme_path, icon_name, mtime)
        cached = self.icon_cache.get(key)
        if cached is not None and cached[0] == sig and not force_icons:
            # Theme files unchanged: omit ThemeFiles to avoid redundant host disk writes
            return None, cached[2]

        theme_files, fallback_pixmaps = locate_and_collect_icons(icon_theme_path, icon_name)
        files_hash = hashlib.sha1(json.dumps(theme_files, sort_keys=True).encode("ascii")).hexdigest()
        prev_hash = cached[1] if cached is not None else ""
        self.icon_cache[key] = (sig, files_hash, fallback_pixmaps)

        if not force_icons and files_hash == prev_hash:
            return None, fallback_pixmaps
        return theme_files, fallback_pixmaps

    def fetch_sni_state(
        self,
        key: str,
        owner: str,
        obj_path: str,
        *,
        force_icons: bool = False,
    ) -> dict | None:
        try:
            obj = self.bus.get_object(owner, obj_path)
            raw = dbus.Interface(obj, PROPS_IFACE).GetAll(SNI_IFACE)
        except Exception:
            return None

        icon_name = str(raw.get("IconName", ""))
        icon_theme_path = str(raw.get("IconThemePath", ""))
        theme_files, fallback_pixmaps = self._get_icons_cached(key, icon_theme_path, icon_name, force_icons)

        if icon_name and os.path.isabs(icon_name):
            icon_name = Path(icon_name).stem

        icon_pixmaps = serialize_pixmaps(raw.get("IconPixmap"))
        if not icon_pixmaps and fallback_pixmaps:
            icon_pixmaps = fallback_pixmaps

        raw_tt = raw.get("ToolTip")
        if isinstance(raw_tt, (tuple, list, dbus.Struct)) and len(raw_tt) >= 4:
            tooltip = {
                "icon_name": str(raw_tt[0]),
                "pixmaps": serialize_pixmaps(raw_tt[1]),
                "title": str(raw_tt[2]),
                "desc": str(raw_tt[3]),
            }
        else:
            tooltip = {
                "icon_name": "",
                "pixmaps": [],
                "title": str(raw.get("Title", "") or raw.get("Id", "")),
                "desc": "",
            }

        menu_obj_path = str(raw.get("Menu", ""))
        if menu_obj_path == "/NO_DBUSMENU":
            menu_obj_path = ""

        state: dict = {
            "Category": str(raw.get("Category", "ApplicationStatus")),
            "Id": str(raw.get("Id", "vm-app")),
            "Title": str(raw.get("Title", "") or raw.get("Id", "VM App")),
            "Status": str(raw.get("Status", "Active")),
            "WindowId": int(raw.get("WindowId", 0)),
            "IconName": icon_name,
            "IconThemePath": icon_theme_path,
            "IconPixmap": icon_pixmaps,
            "OverlayIconName": str(raw.get("OverlayIconName", "")),
            "OverlayIconPixmap": serialize_pixmaps(raw.get("OverlayIconPixmap")),
            "AttentionIconName": str(raw.get("AttentionIconName", "")),
            "AttentionIconPixmap": serialize_pixmaps(raw.get("AttentionIconPixmap")),
            "AttentionMovieName": str(raw.get("AttentionMovieName", "")),
            "ToolTip": tooltip,
            "ItemIsMenu": bool(raw.get("ItemIsMenu", False)),
            "MenuPath": menu_obj_path,
        }
        if theme_files is not None:
            state["ThemeFiles"] = theme_files
        return state

    def fetch_menu_layout(self, owner: str, menu_path: str) -> dict | None:
        if not menu_path:
            return None
        try:
            obj = self.bus.get_object(owner, menu_path)
            rev, root_node = dbus.Interface(obj, DBUSMENU_IFACE).GetLayout(
                dbus.Int32(0),
                dbus.Int32(-1),
                dbus.Array([], signature="s"),
            )
            return {"revision": int(rev), "root": serialize_menu_node(root_node)}
        except Exception:
            return None

    def push_sni_update(self, key: str, refresh_icons: bool = False) -> bool:
        meta = self.items.get(key)
        if not meta:
            return False
        state = self.fetch_sni_state(key, meta["owner"], meta["obj_path"], force_icons=refresh_icons)
        if state:
            self.send_fn({"event": "item_updated", "key": key, "state": state})
        return False

    def push_menu_update(self, key: str) -> bool:
        meta = self.items.get(key)
        if not meta or not meta.get("menu_path"):
            return False
        layout = self.fetch_menu_layout(meta["owner"], meta["menu_path"])
        if layout:
            self.send_fn({"event": "menu_updated", "key": key, "menu": layout})
        return False

    def handle_host_command(self, cmd_obj: dict) -> bool:
        cmd = cmd_obj.get("cmd")
        key = cmd_obj.get("key", "")
        meta = self.items.get(key)
        if not meta:
            return False

        owner = meta["owner"]
        obj_path = meta["obj_path"]
        menu_path = meta.get("menu_path", "")

        try:
            if cmd in ("Activate", "SecondaryActivate", "ContextMenu"):
                obj = self.bus.get_object(owner, obj_path)
                iface = dbus.Interface(obj, SNI_IFACE)
                getattr(iface, cmd)(
                    dbus.Int32(cmd_obj.get("x", 0)),
                    dbus.Int32(cmd_obj.get("y", 0)),
                    reply_handler=lambda *a: None,
                    error_handler=lambda *a: None,
                )
            elif cmd == "Scroll":
                obj = self.bus.get_object(owner, obj_path)
                dbus.Interface(obj, SNI_IFACE).Scroll(
                    dbus.Int32(cmd_obj.get("delta", 0)),
                    dbus.String(cmd_obj.get("orientation", "vertical")),
                    reply_handler=lambda *a: None,
                    error_handler=lambda *a: None,
                )
            elif cmd == "ProvideXdgActivationToken":
                obj = self.bus.get_object(owner, obj_path)
                dbus.Interface(obj, SNI_IFACE).ProvideXdgActivationToken(
                    dbus.String(cmd_obj.get("token", "")),
                    reply_handler=lambda *a: None,
                    error_handler=lambda *a: None,
                )
            elif cmd == "AboutToShow" and menu_path:
                obj = self.bus.get_object(owner, menu_path)
                dbus.Interface(obj, DBUSMENU_IFACE).AboutToShow(
                    dbus.Int32(cmd_obj.get("menu_id", 0)),
                    reply_handler=lambda *a: self.push_menu_update(key),
                    error_handler=lambda *a: None,
                )
            elif cmd == "MenuEvent" and menu_path:
                self.last_menu_event_ts[key] = time.monotonic()
                obj = self.bus.get_object(owner, menu_path)
                dbus.Interface(obj, DBUSMENU_IFACE).Event(
                    dbus.Int32(cmd_obj.get("menu_id", 0)),
                    dbus.String(cmd_obj.get("event_id", "clicked")),
                    dbus.Int32(0, variant_level=1),
                    dbus.UInt32(cmd_obj.get("timestamp", 0)),
                    reply_handler=lambda *a: None,
                    error_handler=lambda *a: None,
                )
        except Exception as exc:
            log_err(f"Command '{cmd}' failed on {key}: {exc}")

        return False


def main() -> None:
    DBusGMainLoop(set_as_default=True)
    loop = GLib.MainLoop()

    vsock_sock = None
    vsock_file_w = None
    vsock_file_r = None
    send_lock = threading.Lock()

    if len(sys.argv) >= 3 and sys.argv[1] == "--vsock":
        vsock_port = int(sys.argv[2])
        try:
            vsock_sock = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
            vsock_sock.connect((2, vsock_port))  # CID 2 = VMADDR_CID_HOST
        except OSError as exc:
            log_err(f"Failed to connect to host AF_VSOCK (CID 2, port {vsock_port}): {exc}")
            sys.exit(1)

        vsock_file_r = vsock_sock.makefile("r", encoding="utf-8", errors="replace")
        vsock_file_w = vsock_sock.makefile("w", encoding="utf-8", buffering=1)
        reader_iter = vsock_file_r
        log_err(f"Connected to host tray daemon via native AF_VSOCK (CID 2, port {vsock_port})")

        def send_fn(payload: dict) -> None:
            with send_lock:
                try:
                    vsock_file_w.write("TRAY_JSON:" + json.dumps(payload, separators=(",", ":")) + "\n")
                    vsock_file_w.flush()
                except Exception:
                    GLib.idle_add(loop.quit)
    else:
        reader_iter = sys.stdin
        log_err("Running guest tray agent in stdio mode (SSH)")

        def send_fn(payload: dict) -> None:
            with send_lock:
                try:
                    sys.stdout.write("TRAY_JSON:" + json.dumps(payload, separators=(",", ":")) + "\n")
                    sys.stdout.flush()
                except Exception:
                    GLib.idle_add(loop.quit)

    agent = GuestTrayAgent(send_fn)

    def reader_worker() -> None:
        try:
            for raw_line in reader_iter:
                line = raw_line.strip()
                if line:
                    try:
                        cmd_obj = json.loads(line)
                        GLib.idle_add(agent.handle_host_command, cmd_obj)
                    except Exception:
                        pass
        except Exception:
            pass
        finally:
            GLib.idle_add(loop.quit)

    def handle_term(_signum, _frame) -> None:
        GLib.idle_add(loop.quit)

    signal.signal(signal.SIGTERM, handle_term)
    signal.signal(signal.SIGINT, handle_term)

