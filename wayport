def build_guest_daemon_systemd_unit(control_port: int = VSOCK_CONTROL_PORT) -> str:
    return (
        "[Unit]\n"
        "Description=wayport Pure-VSOCK Guest Control Daemon\n"
        "Wants=dbus.socket\n"
        "After=dbus.socket\n\n"
        "[Service]\n"
        "Type=simple\n"
        "Environment=PYTHONUNBUFFERED=1\n"
        f"ExecStart=%h/.local/bin/{GUEST_CONTROL_DAEMON_NAME} --port {int(control_port)}\n"
        "Restart=always\n"
        "RestartSec=2\n\n"
        "[Install]\n"
        "WantedBy=default.target\n"
    )


def setup_host_tray_systemd_service(cfg: RuntimeConfig) -> None:
    """Creates, enables, and restarts the per-target host systemd user service for the tray bridge."""
    HOST_SYSTEMD_USER_DIR.mkdir(parents=True, exist_ok=True)
    service_name = cfg.systemd_service_name
    service_path = HOST_SYSTEMD_USER_DIR / service_name

    exec_args = [SCRIPT_ABS_PATH, *cfg.cli_target_args(), "tray-daemon"]
    exec_start = " ".join(shlex.quote(arg) for arg in exec_args)

    unit_content = (
        "[Unit]\n"
        f"Description=wayport System Tray & Notification Bridge ({cfg.vm_label}, mode={cfg.mode})\n"
        "After=graphical-session.target\n"
        "PartOf=graphical-session.target\n\n"
        "[Service]\n"
        "Type=simple\n"
        "Environment=PYTHONUNBUFFERED=1\n"
        f"ExecStart={exec_start}\n"
        "Restart=always\n"
        f"RestartSec={int(TRAY_RECONNECT_DELAY_SEC)}\n\n"
        "[Install]\n"
        "WantedBy=graphical-session.target\n"
    )

    service_path.write_text(unit_content, encoding="utf-8")
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
    subprocess.run(["systemctl", "--user", "enable", "--now", service_name], check=False)
    subprocess.run(["systemctl", "--user", "restart", service_name], check=False)


def _extract_unit_vsock_tray_port(unit_text: str) -> int | None:
    """Returns the AF_VSOCK tray port used by a systemd unit, or None if it runs in ssh mode."""
    if "mode=ssh" in unit_text or "--mode ssh" in unit_text:
        return None
    m = re.search(r"--tray-port\s+(\d+)", unit_text)
    return int(m.group(1)) if m else VSOCK_TRAY_PORT


def find_conflicting_active_tray_service(
    cfg: RuntimeConfig,
    *,
    systemd_dir: Path | None = None,
) -> str | None:
    """
    Returns the name of another active `wayport-tray-*.service` bound to the same
    AF_VSOCK tray port, so a one-off `run` does not spawn a colliding unit.
    """
    if cfg.mode not in ("hybrid", "vsock"):
        return None
    unit_dir = systemd_dir or HOST_SYSTEMD_USER_DIR
    if not unit_dir.is_dir() or not shutil.which("systemctl"):
        return None
    for unit_path in sorted(unit_dir.glob("wayport-tray-*.service")):
        if unit_path.name == cfg.systemd_service_name:
            continue
        try:
            text = unit_path.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        if _extract_unit_vsock_tray_port(text) != cfg.vsock_tray_port:
            continue
        res = subprocess.run(
            ["systemctl", "--user", "is-active", "--quiet", unit_path.name],
            check=False,
        )
        if res.returncode == 0:
            return unit_path.name
    return None


def ensure_tray_daemon_running(cfg: RuntimeConfig) -> None:
    """
    Ensures a host tray bridge service is active for this VM without clobbering
    an already-running unit's mode or spawning a conflicting AF_VSOCK listener.
    """
    if not shutil.which("systemctl"):
        return

    res = subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", cfg.systemd_service_name],
        check=False,
    )
    if res.returncode == 0:
        return

    conflict = find_conflicting_active_tray_service(cfg)
    if conflict is not None:
        print(
            f"[TRAY-NOTE] Active tray service '{conflict}' already owns AF_VSOCK port {cfg.vsock_tray_port}; "
            "skipping duplicate tray service creation (pass --tray-port <PORT> for a separate VM).",
            file=sys.stderr,
        )
        return

    setup_host_tray_systemd_service(cfg)


def format_badge(name: str, vm_label: str) -> str:
    """Appends the VM badge if not already present."""
    badge_marker = f"[{vm_label}]"
    if badge_marker in name or vm_label in name:
        return name
    return DESKTOP_BADGE_FORMAT.format(name=name, vm=vm_label)


def _quote_desktop_exec_arg(arg: str) -> str:
    """Quotes an argument according to the Freedesktop Desktop Entry Exec specification."""
    reserved = set(' \t\n"\'\\><~|&;$*?#()`')
    if not arg or any(ch in reserved for ch in arg):
        escaped = (
            arg.replace("\\", "\\\\")
            .replace('"', '\\"')
            .replace("$", "\\$")
            .replace("`", "\\`")
        )
        return f'"{escaped}"'
    return arg


def rewrite_exec_line(original_exec: str, cfg: RuntimeConfig) -> str:
    """Rewrites a guest `.desktop` Exec= line to invoke `wayport ... run -- <cmd>`."""
    # Preserve literal %% while inspecting field codes
    placeholder = "\x00PERCENT\x00"
    working = original_exec.replace("%%", placeholder)
    has_url_code = bool(re.search(r"%[uU]", working))
    has_file_code = bool(re.search(r"%[fF]", working))

    tokens = shlex.split(working)
    filtered: list[str] = []
    i = 0
    while i < len(tokens):
        tok = tokens[i]
        # Drop file/URL option flags (e.g. `--open-file %U`, `--open-url %U`) that
        # become dangling when the field code is stripped or expanded to empty.
        if (
            tok in ("--open-file", "--open-url")
            and i + 1 < len(tokens)
            and re.fullmatch(r"%[fFuU]", tokens[i + 1])
        ):
            i += 2
            continue
        cleaned_tok = re.sub(r"%[fFuUdDnNickvm]", "", tok).replace(placeholder, "%%")
        if cleaned_tok:
            filtered.append(cleaned_tok)
        i += 1

    if filtered and filtered[0] == "env":
        filtered.pop(0)
        while filtered and "=" in filtered[0] and not filtered[0].startswith("-"):
            filtered.pop(0)

    prefix_tokens = [SCRIPT_ABS_PATH, *cfg.cli_target_args(), "run", "--"]
    full_tokens = prefix_tokens + filtered
    rewritten = " ".join(_quote_desktop_exec_arg(tok) for tok in full_tokens)
    if has_url_code:
        rewritten += " %U"
    elif has_file_code:
        rewritten += " %F"
    return rewritten


def save_guest_icon(cfg: RuntimeConfig, transport: ControlTransport, icon_name: str) -> str:
    """Fetches an application icon via the active transport and stores it in HOST_ICONS_DIR."""
    if not icon_name:
        return "application-x-executable"
    fetched = transport.fetch_icon(icon_name)
    if fetched is None:
        return icon_name

    ext, icon_bytes = fetched
    HOST_ICONS_DIR.mkdir(parents=True, exist_ok=True)
    safe_icon_id = re.sub(r"[^a-zA-Z0-9._-]+", "-", Path(icon_name).stem).strip("-.") or "icon"
    local_icon_path = HOST_ICONS_DIR / f"wayport-{cfg.vm_slug}-{safe_icon_id}{ext}"
    local_icon_path.write_bytes(icon_bytes)
    return str(local_icon_path)


def transform_desktop_file(
    raw_content: str,
    cfg: RuntimeConfig,
    resolved_icon: str,
) -> str:
    """Transforms a guest `.desktop` file so it launches cleanly from the host DE."""
    lines = raw_content.splitlines()
    output_lines: list[str] = []
    current_section = ""

    for line in lines:
        stripped = line.strip()

        if stripped.startswith("[") and stripped.endswith("]"):
            current_section = stripped
            output_lines.append(line)
            continue

        if stripped.startswith(("TryExec=", "Path=")):
            continue

        if stripped.startswith("DBusActivatable="):
            output_lines.append("DBusActivatable=false")
            continue

        if current_section == "[Desktop Entry]" and re.match(r"^Name(\[[^\]]+\])?=", stripped):
            key, val = stripped.split("=", 1)
            output_lines.append(f"{key}={format_badge(val, cfg.vm_label)}")
            continue

        if stripped.startswith("Exec="):
            _, orig_cmd = stripped.split("=", 1)
            output_lines.append(f"Exec={rewrite_exec_line(orig_cmd, cfg)}")
            continue

        if current_section == "[Desktop Entry]" and stripped.startswith("Icon="):
            output_lines.append(f"Icon={resolved_icon}")
            continue

        output_lines.append(line)

    return "\n".join(output_lines) + "\n"


def extract_desktop_entry_icon(raw_content: str) -> str:
    """Extracts the Icon= value specifically from the [Desktop Entry] section."""
    current_section = ""
    for line in raw_content.splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            current_section = stripped
            continue
        if current_section == "[Desktop Entry]" and stripped.startswith("Icon="):
            return stripped.split("=", 1)[1].strip()
    return ""


def refresh_host_desktop_cache() -> None:
    """Rebuilds the XDG desktop database and KDE Plasma 6's `ksycoca6` cache."""
    if shutil.which("update-desktop-database"):
        subprocess.run(
            ["update-desktop-database", str(HOST_APPS_DIR)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    if shutil.which("kbuildsycoca6"):
        subprocess.run(
            ["kbuildsycoca6"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )


def list_guest_applications(cfg: RuntimeConfig) -> None:
    """Lists exportable GUI applications inside the guest."""
    transport = create_control_transport(cfg)
    apps = transport.list_apps()
    print(f"{'APP ID (Use this for export)':<45} | {'APPLICATION NAME'}")
    print("-" * 80)
    for app_id, name in apps:
        print(f"{app_id:<45} | {name}")


def export_applications(cfg: RuntimeConfig, app_ids: list[str]) -> None:
    """Deploys guest scripts, exports .desktop files + icons, and enables the host tray service."""
    transport = create_control_transport(cfg)
    transport.ensure_guest_scripts(force=True)
    script_hash = compute_guest_scripts_hash(cfg.vsock_control_port)
    print(f"[OK] Synced guest scripts ({script_hash}, mode={cfg.mode}) for '{cfg.vm_label}'")

    HOST_APPS_DIR.mkdir(parents=True, exist_ok=True)
    exported_count = 0

    for app_id in app_ids:
        clean_id = app_id[:-8] if app_id.endswith(".desktop") else app_id
        raw_text = transport.read_desktop_file(clean_id)
        if not raw_text:
            print(f"[WARN] Application '{clean_id}' not found on '{cfg.vm_label}'. Skipping.", file=sys.stderr)
            continue

        raw_icon = extract_desktop_entry_icon(raw_text)
        resolved_icon = save_guest_icon(cfg, transport, raw_icon)
        transformed_text = transform_desktop_file(raw_text, cfg, resolved_icon)

        target_file = HOST_APPS_DIR / f"wayport-{cfg.vm_slug}-{clean_id}.desktop"
        target_file.write_text(transformed_text, encoding="utf-8")
        target_file.chmod(0o644)
        print(f"[OK] Exported '{clean_id}' -> {target_file}")
        exported_count += 1

    if exported_count > 0:
        setup_host_tray_systemd_service(cfg)
        print(f"[OK] Enabled & restarted host tray service: {cfg.systemd_service_name}")
        refresh_host_desktop_cache()
        print("[DONE] Desktop launcher cache updated.")


def remove_applications(cfg: RuntimeConfig, app_ids: list[str], remove_all: bool) -> None:
    """Removes exported .desktop files, icons, and (when --all) the per-VM tray service."""
    prefixes = {cfg.vm_slug, cfg.vm_label}
    if cfg.vm_target:
        prefixes.add(cfg.vm_target)

    if remove_all:
        for prefix in prefixes:
            for path in HOST_APPS_DIR.glob(f"wayport-{prefix}-*.desktop"):
                path.unlink(missing_ok=True)
                print(f"[REMOVED] {path}")
            if HOST_ICONS_DIR.exists():
                for path in HOST_ICONS_DIR.glob(f"wayport-{prefix}-*"):
                    path.unlink(missing_ok=True)
                    print(f"[REMOVED] {path}")
        service_path = HOST_SYSTEMD_USER_DIR / cfg.systemd_service_name
        if service_path.exists():
            if shutil.which("systemctl"):
                subprocess.run(["systemctl", "--user", "disable", "--now", cfg.systemd_service_name], check=False)
            service_path.unlink(missing_ok=True)
            print(f"[REMOVED] {service_path}")
    else:
        for app_id in app_ids:
            clean_id = app_id[:-8] if app_id.endswith(".desktop") else app_id
            for prefix in prefixes:
                target_file = HOST_APPS_DIR / f"wayport-{prefix}-{clean_id}.desktop"
                if target_file.exists():
                    target_file.unlink()
                    print(f"[REMOVED] {target_file}")

    refresh_host_desktop_cache()
    print("[DONE] Desktop launcher cache updated.")


def install_guest_components(cfg: RuntimeConfig, local: bool) -> None:
    """
    Installs guest scripts (`wayport-wrapper`, `wayport-tray-agent`, `wayport-daemon`)
    and enables `wayport-guest.service` either locally (inside the VM) or remotely via SSH.
    """
    if local:
        bin_dir = Path(os.path.expanduser(GUEST_BIN_DIR))
        bin_dir.mkdir(parents=True, exist_ok=True)

        files = {
            GUEST_WRAPPER_NAME: render_guest_wrapper(),
            GUEST_TRAY_AGENT_NAME: render_guest_tray_agent(),
            GUEST_CONTROL_DAEMON_NAME: render_guest_control_daemon(cfg.vsock_control_port),
        }
        for name, content in files.items():
            target = bin_dir / name
            target.write_text(content, encoding="utf-8")
            target.chmod(0o755)
            print(f"[OK] Installed {target}")

        unit_dir = Path.home() / ".config" / "systemd" / "user"
        unit_dir.mkdir(parents=True, exist_ok=True)
        unit_path = unit_dir / GUEST_SYSTEMD_UNIT_NAME
        unit_path.write_text(build_guest_daemon_systemd_unit(cfg.vsock_control_port), encoding="utf-8")
        print(f"[OK] Wrote {unit_path}")

        if shutil.which("systemctl"):
            subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
            subprocess.run(["systemctl", "--user", "enable", "--now", GUEST_SYSTEMD_UNIT_NAME], check=False)
            subprocess.run(["systemctl", "--user", "restart", GUEST_SYSTEMD_UNIT_NAME], check=False)
            print(f"[OK] Enabled & started {GUEST_SYSTEMD_UNIT_NAME} (AF_VSOCK port {cfg.vsock_control_port})")
        else:
            print(f"[WARN] systemctl not found; start {bin_dir / GUEST_CONTROL_DAEMON_NAME} manually.")

        if shutil.which("loginctl"):
            user_name = os.environ.get("USER") or Path.home().name
            subprocess.run(["loginctl", "enable-linger", user_name], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            chk = subprocess.run(
                ["loginctl", "show-user", user_name, "-p", "Linger"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                check=False,
            )
            if "Linger=yes" in chk.stdout:
                print(f"[OK] Enabled systemd linger for '{user_name}' (starts at boot without login)")
            else:
                print(
                    f"[WARN] Could not enable systemd linger automatically for '{user_name}'. "
                    f"Run `sudo loginctl enable-linger {user_name}` so {GUEST_SYSTEMD_UNIT_NAME} starts on VM boot without login."
                )
        return

    if not cfg.vm_target:
        raise TransportError(
            "Remote `install-guest` requires --target user@host, or run `wayport install-guest --local` inside the VM."
        )
    ssh_transport = SSHControlTransport(cfg)
    linger_ok = ssh_transport.deploy_guest_control_daemon()
    print(
        f"[OK] Installed guest scripts & enabled {GUEST_SYSTEMD_UNIT_NAME} on '{cfg.vm_target}' "
        f"(AF_VSOCK control port {cfg.vsock_control_port})."
    )
    if linger_ok:
        print("[OK] Enabled systemd linger on guest (daemon starts automatically on VM boot without login).")
    else:
        print(
            "[WARN] Could not verify systemd linger on guest. "
            "Run `sudo loginctl enable-linger \"$USER\"` inside the VM so the daemon starts on boot without login."
        )
    print("     You can now use pure socket mode without SSH: `wayport --mode vsock --cid <CID> list`")


def run_doctor(cfg: RuntimeConfig) -> int:
    """Checks host (and optional guest) prerequisites for the selected transport mode."""
    print(f"wayport {__version__} doctor (mode={cfg.mode}, compression={cfg.compression}, no_gpu={cfg.no_gpu})")
    print("-" * 72)

    ok_all = True

    def report(label: str, ok: bool, detail: str, optional: bool = False) -> None:
        nonlocal ok_all
        tag = "OK" if ok else ("WARN" if optional else "FAIL")
        print(f"[{tag:<4}] {label:<28} {detail}")
        if not ok and not optional:
            ok_all = False

    wp = shutil.which("waypipe")
    wp_ver = ""
    if wp:
        res = subprocess.run([wp, "--version"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, check=False)
        wp_ver = (res.stdout.splitlines()[0] if res.stdout else wp).strip()
    report("Host waypipe", bool(wp), wp_ver or "missing (install waypipe)")

    has_dbus = False
    try:
        import dbus  # noqa: F401
        has_dbus = True
    except Exception:
        pass
    report("Python dbus (tray daemon)", has_dbus, "installed" if has_dbus else "missing (install python3-dbus)", optional=True)

    has_gi = False
    try:
        from gi.repository import GLib  # noqa: F401
        has_gi = True
    except Exception:
        pass
    report("PyGObject GLib (tray)", has_gi, "installed" if has_gi else "missing (install python3-gi)", optional=True)

    if cfg.mode in ("hybrid", "vsock"):
        has_af_vsock = hasattr(socket, "AF_VSOCK")
        has_vhost = Path("/dev/vhost-vsock").exists()
        report("Python socket.AF_VSOCK", has_af_vsock, "supported" if has_af_vsock else "not supported by Python build")
        report("Host /dev/vhost-vsock", has_vhost, "present" if has_vhost else "missing (run: sudo modprobe vhost_vsock)")

    if cfg.mode in ("hybrid", "ssh"):
        ssh_bin = shutil.which("ssh")
        report("OpenSSH client (ssh)", bool(ssh_bin), ssh_bin or "missing (install openssh-client)")

    # Test guest connectivity if a target/CID was supplied
    has_target = (cfg.mode == "vsock" and cfg.vsock_cid is not None) or (cfg.mode != "vsock" and bool(cfg.vm_target))
    if has_target:
        transport = create_control_transport(cfg)
        guest_ok, guest_detail = transport.check_health()
        report(f"Guest ({cfg.vm_label})", guest_ok, guest_detail)
    else:
        report("Target connectivity", True, "skipped (pass --target or --cid to test)", optional=True)

    print("-" * 72)
    print("Result:", "READY" if ok_all else "ISSUES DETECTED")
    return 0 if ok_all else 1


