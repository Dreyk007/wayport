def needs_chromium_wayland_flags(binary_path: str) -> bool:
    """Checks if the target executable is a known Chromium or Electron binary."""
    binary_name = Path(binary_path).name.lower()
    return any(binary_name.startswith(prefix) for prefix in CHROMIUM_BINARIES)


def _wait_for_waypipe_client_socket(
    sock_path: Path,
    client_proc: subprocess.Popen,
    timeout: float = 3.0,
) -> None:
    """Waits for host `waypipe client` to create its Unix socket, failing fast if it exits."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if sock_path.exists():
            return
        rc = client_proc.poll()
        if rc is not None:
            raise TransportError(f"Host `waypipe client` exited prematurely with status {rc}.")
        time.sleep(0.01)
    raise TransportError(f"Timed out waiting for host `waypipe client` socket at {sock_path}.")


def run_guest_application(cfg: RuntimeConfig, cmd_tokens: list[str], *, start_tray: bool = True) -> int:
    """Launches a guest GUI application using the configured transport mode."""
    if not cmd_tokens:
        raise TransportError("No guest command specified for 'run'.")

    transport = create_control_transport(cfg)
    meta = transport.ensure_guest_scripts(force=False)
    if start_tray and AUTO_START_TRAY_ON_RUN:
        ensure_tray_daemon_running(cfg)

    executable = cmd_tokens[0]
    app_args = list(cmd_tokens[1:])

    if needs_chromium_wayland_flags(executable):
        for flag in CHROMIUM_EXTRA_FLAGS:
            flag_prefix = flag.split("=", 1)[0]
            if not any(arg == flag_prefix or arg.startswith(flag_prefix + "=") for arg in app_args):
                app_args.append(flag)

    uid = os.getuid()
    runtime_dir = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{uid}"))
    session_token = secrets.token_hex(4)
    waypipe_sock_path = runtime_dir / f"wayport-client-{os.getpid()}-{session_token}.sock"
    waypipe_sock_path.unlink(missing_ok=True)

    host_client_cmd = ["waypipe", "-c", cfg.compression]
    if cfg.no_gpu:
        host_client_cmd.append("--no-gpu")
    host_client_cmd.extend(["-s", str(waypipe_sock_path), "client"])

    client_proc = subprocess.Popen(host_client_cmd, start_new_session=True)
    client_handle = PopenHandle(client_proc, use_pgroup=True)

    listener_sock: socket.socket | None = None
    proxy_sock_path: Path | None = None
    guest_handle: ManagedProcessHandle | None = None
    stop_event = threading.Event()

    def handle_signal(_signum, _frame) -> None:
        stop_event.set()

    prev_sigterm = signal.signal(signal.SIGTERM, handle_signal)
    prev_sigint = signal.signal(signal.SIGINT, handle_signal)

    try:
        _wait_for_waypipe_client_socket(waypipe_sock_path, client_proc)

        if cfg.mode in ("hybrid", "vsock"):
            listener_sock, vsock_port = create_vsock_listener()
            threading.Thread(
                target=accept_and_bridge_loop,
                args=(listener_sock, str(waypipe_sock_path)),
                kwargs={"mask_idle_inhibit": cfg.effective_mask_idle_inhibit},
                daemon=True,
            ).start()

            if cfg.mode == "vsock":
                assert isinstance(transport, VsockControlTransport)
                guest_handle = transport.open_session(
                    {
                        "op": "run",
                        "vsock_port": vsock_port,
                        "compression": cfg.compression,
                        "no_gpu": cfg.no_gpu,
                        "cmd": [executable, *app_args],
                    },
                    forward_output=True,
                )
            else:
                quoted_cmd = " ".join(shlex.quote(tok) for tok in [executable, *app_args])
                gpu_flag = "--no-gpu" if cfg.no_gpu else "--gpu"
                remote_cmd = (
                    f"{GUEST_BIN_DIR}/{GUEST_WRAPPER_NAME} "
                    f"--vsock-port {vsock_port} --compression {shlex.quote(cfg.compression)} "
                    f"{gpu_flag} -- {quoted_cmd}"
                )
                ssh_cmd = _build_ssh_base_cmd(cfg.vm_target, disable_mux=True) + [remote_cmd]
                guest_handle = PopenHandle(subprocess.Popen(ssh_cmd, stdin=subprocess.DEVNULL))
        else:
            # Pure SSH mode: forward a unique remote Unix socket to host proxy or waypipe client
            local_forward_target = waypipe_sock_path
            if cfg.effective_mask_idle_inhibit:
                proxy_sock_path = runtime_dir / f"wayport-proxy-{os.getpid()}-{session_token}.sock"
                listener_sock = create_unix_listener(proxy_sock_path)
                threading.Thread(
                    target=accept_and_bridge_loop,
                    args=(listener_sock, str(waypipe_sock_path)),
                    kwargs={"mask_idle_inhibit": True},
                    daemon=True,
                ).start()
                local_forward_target = proxy_sock_path

            remote_rt_dir = str(meta.get("remote_runtime_dir") or "/tmp").rstrip("/")
            remote_sock = f"{remote_rt_dir}/wayport-ssh-{os.getpid()}-{session_token}.sock"
            quoted_cmd = " ".join(shlex.quote(tok) for tok in [executable, *app_args])
            gpu_flag = "--no-gpu" if cfg.no_gpu else "--gpu"
            remote_cmd = (
                f"{GUEST_BIN_DIR}/{GUEST_WRAPPER_NAME} "
                f"--unix-sock {shlex.quote(remote_sock)} --compression {shlex.quote(cfg.compression)} "
                f"{gpu_flag} -- {quoted_cmd}"
            )
            ssh_cmd = _build_ssh_base_cmd(
                cfg.vm_target,
                disable_mux=True,
                extra_args=[
                    "-o",
                    "ExitOnForwardFailure=yes",
                    "-R",
                    f"{remote_sock}:{local_forward_target}",
                ],
            ) + [remote_cmd]
            guest_handle = PopenHandle(subprocess.Popen(ssh_cmd, stdin=subprocess.DEVNULL))

        while not stop_event.is_set():
            if guest_handle.poll() is not None or client_handle.poll() is not None:
                break
            time.sleep(0.05)

        rc = guest_handle.poll()
        return int(rc) if rc is not None else 0
    finally:
        signal.signal(signal.SIGTERM, prev_sigterm)
        signal.signal(signal.SIGINT, prev_sigint)
        if listener_sock is not None:
            try:
                listener_sock.close()
            except OSError:
                pass
        terminate_handle_cleanly(guest_handle)
        terminate_handle_cleanly(client_handle)
        waypipe_sock_path.unlink(missing_ok=True)
        if proxy_sock_path is not None:
            proxy_sock_path.unlink(missing_ok=True)


