GUEST_WRAPPER_TEMPLATE = r"""#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Automatically deployed by wayport.
# Outer modes:
#   wayport-wrapper --vsock-port <PORT> [--compression <C>] [--no-gpu|--gpu] [--] <cmd> [args...]
#   wayport-wrapper --unix-sock <PATH>  [--compression <C>] [--no-gpu|--gpu] [--] <cmd> [args...]
# Inner mode (invoked by `waypipe server`):
#   wayport-wrapper --inner <cmd> [args...]

set -uo pipefail

ENABLE_PORTAL_ROUTING=__ENABLE_PORTAL_ROUTING__
ENABLE_SINGLETON_TAKEOVER=__ENABLE_SINGLETON_TAKEOVER__
VULKAN_USE_LVP=__VULKAN_USE_LVP__
GUEST_LOCALE=__GUEST_LOCALE__
FAST_FORK_THRESHOLD_SEC=__FAST_FORK_THRESHOLD_SEC__
AUTO_DETECT_ELECTRON=__AUTO_DETECT_ELECTRON__
ELECTRON_SHM_NUDGE_APPS=(__ELECTRON_SHM_NUDGE_APPS__)
ELECTRON_SHM_NUDGE_DELAY_SEC=__ELECTRON_SHM_NUDGE_DELAY_SEC__

UID_VAL="$(id -u)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${UID_VAL}}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

if [ "${1:-}" = "--vsock-port" ] || [ "${1:-}" = "--unix-sock" ]; then
    TRANSPORT_KIND="$1"
    TRANSPORT_TARGET="${2:-}"
    shift 2

    WP_COMP="none"
    WP_NO_GPU="1"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --compression)
                WP_COMP="${2:-none}"
                shift 2
                ;;
            --no-gpu)
                WP_NO_GPU="1"
                shift
                ;;
            --gpu)
                WP_NO_GPU="0"
                shift
                ;;
            --)
                shift
                break
                ;;
            *)
                break
                ;;
        esac
    done

    if [ "$#" -eq 0 ]; then
        echo "[ERROR] No guest command provided to wayport-wrapper." >&2
        exit 1
    fi

    WP_ARGS=(-c "$WP_COMP")
    if [ "$WP_NO_GPU" = "1" ]; then
        WP_ARGS+=(--no-gpu)
    fi
    export WAYPORT_NO_GPU="$WP_NO_GPU"

    if [ "$TRANSPORT_KIND" = "--vsock-port" ]; then
        if [ ! -e /dev/vsock ]; then
            echo "[ERROR] /dev/vsock is missing inside the guest VM. Attach a Virtio VSOCK device." >&2
            exit 1
        fi
        export WAYPORT_INSTANCE_ID="wayport_vsock_${TRANSPORT_TARGET}_$$_${RANDOM}"
        exec waypipe "${WP_ARGS[@]}" --vsock -s "$TRANSPORT_TARGET" server -- "$0" --inner "$@"
    else
        export WAYPORT_UNIX_SOCK="$TRANSPORT_TARGET"
        export WAYPORT_INSTANCE_ID="wayport_ssh_$$_${RANDOM}"
        exec waypipe "${WP_ARGS[@]}" -s "$TRANSPORT_TARGET" server -- "$0" --inner "$@"
    fi
fi

if [ "${1:-}" = "--inner" ]; then
    shift
fi

if [ "$#" -eq 0 ]; then
    echo "[ERROR] No guest command provided to wayport-wrapper --inner." >&2
    exit 1
fi

export WAYPORT_INSTANCE_ID="${WAYPORT_INSTANCE_ID:-wayport_$$_${RANDOM}}"
WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}"

case "$WAYLAND_DISPLAY" in
    /*) WP_SOCK="$WAYLAND_DISPLAY" ;;
    *)  WP_SOCK="${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ;;
esac

# 1. Configure xdg-desktop-portal for KDE FileChooser/Settings while disabling
#    Notification/Inhibit portals so apps use our fast D-Bus responders directly.
if [ "$ENABLE_PORTAL_ROUTING" -eq 1 ]; then
    mkdir -p "${HOME}/.config/xdg-desktop-portal"
    cat > "${HOME}/.config/xdg-desktop-portal/portals.conf" << 'EOF'
[preferred]
default=kde
org.freedesktop.impl.portal.FileChooser=kde
org.freedesktop.impl.portal.Settings=kde
org.freedesktop.impl.portal.Inhibit=none
org.freedesktop.impl.portal.Notification=none
org.freedesktop.impl.portal.Background=none
org.freedesktop.impl.portal.GlobalShortcuts=none
EOF
fi

# 2. Safe singleton takeover: match ONLY process comm/executable name (not arbitrary
#    command-line substrings) and terminate only non-waypipe or stale-socket instances.
APP_BIN="$(basename "$1")"
APP_MATCH="$APP_BIN"
case "$APP_BIN" in
    google-chrome*|chromium*) APP_MATCH="chrome" ;;
    claude*)                  APP_MATCH="claude" ;;
    antigravity*)             APP_MATCH="antigravity" ;;
    code|code-insiders)       APP_MATCH="code" ;;
esac

matches_app_proc() {
    local pid="$1"
    local comm exe_base
    comm="$(tr -d '\n' < "/proc/${pid}/comm" 2>/dev/null || true)"
    exe_base="$(basename "$(readlink -f "/proc/${pid}/exe" 2>/dev/null || true)" 2>/dev/null || true)"
    case "$comm" in
        "$APP_MATCH"|"$APP_MATCH"*|"$APP_BIN"|"$APP_BIN"*) return 0 ;;
    esac
    case "$exe_base" in
        "$APP_MATCH"|"$APP_MATCH"*|"$APP_BIN"|"$APP_BIN"*) return 0 ;;
    esac
    return 1
}

SKIP_SINGLETON_TAKEOVER=0
case "$APP_BIN" in
    sh|bash|dash|zsh|fish|env|python|python3|python3.*|node|perl|ruby|java|flatpak|snap)
        SKIP_SINGLETON_TAKEOVER=1
        ;;
esac

if [ "$ENABLE_SINGLETON_TAKEOVER" -eq 1 ] && [ "$SKIP_SINGLETON_TAKEOVER" -eq 0 ]; then
    ANCESTOR_PIDS=" $$ $PPID "
    cur="$PPID"
    while [ -n "$cur" ] && [ "$cur" -gt 1 ] 2>/dev/null; do
        parent="$(sed -n 's/.*) [^ ]* \([0-9]*\).*/\1/p' "/proc/${cur}/stat" 2>/dev/null || true)"
        [ -n "$parent" ] || break
        [ "$parent" = "$cur" ] && break
        ANCESTOR_PIDS="${ANCESTOR_PIDS}${parent} "
        cur="$parent"
    done

    KILLED_PIDS=()
    for pid_dir in /proc/[0-9]*; do
        pid="${pid_dir#/proc/}"
        case "$ANCESTOR_PIDS" in
            *" ${pid} "*) continue ;;
        esac
        proc_uid="$(stat -c %u "$pid_dir" 2>/dev/null || true)"
        [ "$proc_uid" = "$UID_VAL" ] || continue

        matches_app_proc "$pid" || continue

        [ -r "${pid_dir}/cmdline" ] || continue
        cmdline="$({ tr '\0' ' ' < "${pid_dir}/cmdline"; } 2>/dev/null || true)"
        [ -n "$cmdline" ] || continue
        case "$cmdline" in
            *waypipe*|*wayport-tray-agent*|*wayport-daemon*) continue ;;
        esac

        PROC_WD="$({ tr '\0' '\n' < "${pid_dir}/environ"; } 2>/dev/null | sed -n 's/^WAYLAND_DISPLAY=//p' | head -n 1 || true)"
        case "$PROC_WD" in
            /*) PROC_SOCK="$PROC_WD" ;;
            *)  PROC_SOCK="${XDG_RUNTIME_DIR}/${PROC_WD}" ;;
        esac

        if ! grep -Fqz "WAYPORT_SESSION=1" "${pid_dir}/environ" 2>/dev/null || [ ! -S "$PROC_SOCK" ]; then
            kill -TERM "$pid" 2>/dev/null || true
