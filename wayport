def _build_ssh_base_cmd(
    vm_target: str,
    *,
    disable_mux: bool = False,
    extra_args: list[str] | None = None,
) -> list[str]:
    cmd = [
        "ssh",
        "-o",
        "BatchMode=yes",
        "-o",
        f"ConnectTimeout={SSH_CONNECT_TIMEOUT}",
        "-o",
        f"ServerAliveInterval={SSH_SERVER_ALIVE_INTERVAL}",
        "-o",
        f"ServerAliveCountMax={SSH_SERVER_ALIVE_COUNT_MAX}",
    ]
    if disable_mux:
        cmd.extend(["-o", "ControlMaster=no", "-o", "ControlPath=none"])
    for opt in SSH_EXTRA_OPTIONS:
        cmd.extend(["-o", opt])
    if extra_args:
        cmd.extend(extra_args)
    cmd.append(vm_target)
    return cmd


class ManagedProcessHandle(ABC):
    """Uniform handle interface for SSH Popen processes and VSOCK RPC sessions."""

    @abstractmethod
    def poll(self) -> int | None:
        ...

    @abstractmethod
    def terminate(self) -> None:
        ...

    @abstractmethod
    def wait(self, timeout: float | None = None) -> int | None:
        ...

    @abstractmethod
    def kill(self) -> None:
        ...


class PopenHandle(ManagedProcessHandle):
    """Wraps a `subprocess.Popen` process (optionally terminating its full process group)."""

    def __init__(self, proc: subprocess.Popen, *, use_pgroup: bool = False) -> None:
        self.proc = proc
        self.use_pgroup = use_pgroup

    def poll(self) -> int | None:
        return self.proc.poll()

    def terminate(self) -> None:
        if self.proc.poll() is None:
            try:
                if self.use_pgroup:
                    os.killpg(self.proc.pid, signal.SIGTERM)
                else:
                    self.proc.terminate()
            except OSError:
                try:
                    self.proc.terminate()
                except OSError:
                    pass

    def wait(self, timeout: float | None = None) -> int | None:
        try:
            return self.proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            return None

    def kill(self) -> None:
        if self.proc.poll() is None:
            try:
                if self.use_pgroup:
                    os.killpg(self.proc.pid, signal.SIGKILL)
                else:
                    self.proc.kill()
            except OSError:
                try:
                    self.proc.kill()
                except OSError:
                    pass


class VsockSessionHandle(ManagedProcessHandle):
    """Tracks a long-lived `run` or `start_tray` RPC session over AF_VSOCK."""

    def __init__(self, sock: socket.socket, forward_output: bool = True) -> None:
        self._sock = sock
        self._forward_output = forward_output
        self._exit_code: int | None = None
        self._done = threading.Event()
        self._reader_thread = threading.Thread(target=self._read_loop, daemon=True)
        self._reader_thread.start()

    def _read_loop(self) -> None:
        try:
            with self._sock.makefile("r", encoding="utf-8", errors="replace") as reader:
                for raw_line in reader:
                    line = raw_line.strip()
                    if not line:
                        continue
                    try:
                        msg = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    ev = msg.get("event")
                    if ev == "stdout" and self._forward_output:
                        sys.stdout.write(msg.get("data", ""))
                        sys.stdout.flush()
                    elif ev == "stderr" and self._forward_output:
                        sys.stderr.write(msg.get("data", ""))
                        sys.stderr.flush()
                    elif ev == "exit":
                        self._exit_code = int(msg.get("code", 0))
                        break
                    elif msg.get("ok") is False:
                        sys.stderr.write(f"[ERROR] Guest daemon error: {msg.get('error', 'unknown')}\n")
                        self._exit_code = 1
                        break
        except OSError:
            pass
        finally:
            if self._exit_code is None:
                self._exit_code = 0
            self._done.set()
            try:
                self._sock.close()
            except OSError:
                pass

    def poll(self) -> int | None:
        return self._exit_code if self._done.is_set() else None

    def terminate(self) -> None:
        try:
            self._sock.sendall(b'{"op":"terminate"}\n')
        except OSError:
            pass
        try:
            self._sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass

    def wait(self, timeout: float | None = None) -> int | None:
        self._done.wait(timeout=timeout)
        return self._exit_code if self._done.is_set() else None

    def kill(self) -> None:
        try:
            self._sock.close()
        except OSError:
            pass


def terminate_handle_cleanly(handle: ManagedProcessHandle | None, timeout: float = 2.0) -> None:
    """Terminates a process/session handle, waits briefly, and falls back to kill()."""
    if handle is None:
        return
    if handle.poll() is not None:
        handle.wait(timeout=0.1)
        return
    handle.terminate()
    if handle.wait(timeout=timeout) is None:
        handle.kill()
        handle.wait(timeout=1.0)


class ControlTransport(ABC):
    """Abstract control plane for host-to-guest operations."""

    def __init__(self, cfg: RuntimeConfig) -> None:
        self.cfg = cfg

    @abstractmethod
    def list_apps(self) -> list[tuple[str, str]]:
        ...

    @abstractmethod
    def read_desktop_file(self, app_id: str) -> str | None:
        ...

    @abstractmethod
    def fetch_icon(self, icon_name: str) -> tuple[str, bytes] | None:
        ...

    @abstractmethod
    def ensure_guest_scripts(self, force: bool = False) -> dict[str, Any]:
        ...

    @abstractmethod
    def check_health(self) -> tuple[bool, str]:
        ...


class SSHControlTransport(ControlTransport):
    """Control plane implemented over non-interactive OpenSSH (`BatchMode=yes`)."""

    def run_command(
        self,
        remote_command: str,
        *,
        stdin_bytes: bytes | None = None,
        check: bool = True,
    ) -> bytes:
        cmd = _build_ssh_base_cmd(self.cfg.vm_target) + [remote_command]
        try:
            result = subprocess.run(
                cmd,
                input=stdin_bytes,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=check,
            )
            return result.stdout
        except FileNotFoundError as exc:
            raise TransportError("OpenSSH client (`ssh`) is not installed on the host.") from exc
        except subprocess.CalledProcessError as exc:
            err_msg = exc.stderr.decode("utf-8", errors="replace").strip()
            raise TransportError(f"SSH command failed on '{self.cfg.vm_target}': {err_msg}") from exc

    def _cache_marker_path(self) -> Path:
        script_hash = compute_guest_scripts_hash(self.cfg.vsock_control_port)
        return HOST_CACHE_DIR / f"scripts-{script_hash}-{self.cfg.vm_slug}.json"

    def ensure_guest_scripts(self, force: bool = False) -> dict[str, Any]:
        HOST_CACHE_DIR.mkdir(parents=True, exist_ok=True)
        marker_file = self._cache_marker_path()

        if marker_file.exists() and not force:
            try:
                return json.loads(marker_file.read_text(encoding="utf-8"))
            except Exception:
                pass

        bin_dir = GUEST_BIN_DIR
        self.run_command(
            f"mkdir -p {bin_dir} && cat > {bin_dir}/{GUEST_WRAPPER_NAME} && chmod 0755 {bin_dir}/{GUEST_WRAPPER_NAME}",
            stdin_bytes=render_guest_wrapper().encode("utf-8"),
            check=True,
        )
        self.run_command(
            f"mkdir -p {bin_dir} && cat > {bin_dir}/{GUEST_TRAY_AGENT_NAME} && chmod 0755 {bin_dir}/{GUEST_TRAY_AGENT_NAME}",
            stdin_bytes=render_guest_tray_agent().encode("utf-8"),
            check=True,
        )

        # Query guest runtime dir once (used for clean ssh -R socket placement)
        rt_out = self.run_command(
            'printf "%s" "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"',
            check=False,
        ).decode("utf-8", errors="replace").strip()

        meta = {
            "hash": compute_guest_scripts_hash(self.cfg.vsock_control_port),
            "remote_runtime_dir": rt_out or "/tmp",
            "deployed_at": int(time.time()),
        }
        marker_file.write_text(json.dumps(meta), encoding="utf-8")
        return meta

    def deploy_guest_control_daemon(self) -> bool:
        """
        Installs wayport-daemon, enables its systemd user unit, and attempts to enable
        systemd user lingering over SSH so the daemon starts on VM boot without login.
        Returns True if lingering was confirmed/enabled, False otherwise.
        """
        bin_dir = GUEST_BIN_DIR
        self.ensure_guest_scripts(force=True)
        self.run_command(
            f"mkdir -p {bin_dir} && cat > {bin_dir}/{GUEST_CONTROL_DAEMON_NAME} && chmod 0755 {bin_dir}/{GUEST_CONTROL_DAEMON_NAME}",
            stdin_bytes=render_guest_control_daemon(self.cfg.vsock_control_port).encode("utf-8"),
            check=True,
        )
        unit_text = build_guest_daemon_systemd_unit(self.cfg.vsock_control_port)
        self.run_command(
            f"mkdir -p ~/.config/systemd/user && cat > ~/.config/systemd/user/{GUEST_SYSTEMD_UNIT_NAME} "
            f"&& systemctl --user daemon-reload "
            f"&& systemctl --user enable --now {GUEST_SYSTEMD_UNIT_NAME} "
            f"&& systemctl --user restart {GUEST_SYSTEMD_UNIT_NAME}",
            stdin_bytes=unit_text.encode("utf-8"),
            check=True,
        )
        linger_out = self.run_command(
            'if command -v loginctl >/dev/null 2>&1; then '
            'loginctl enable-linger "$USER" >/dev/null 2>&1 || true; '
            'loginctl show-user "$USER" -p Linger 2>/dev/null || true; '
            'fi',
            check=False,
        ).decode("utf-8", errors="replace")
        return "Linger=yes" in linger_out

    def list_apps(self) -> list[tuple[str, str]]:
        dirs_json = json.dumps(list(DESKTOP_APP_SEARCH_DIRS))
        py_code = (
            "import glob, json, os, sys\n"
            "dirs = json.loads(sys.argv[1])\n"
            "seen = set()\n"
            "out = []\n"
            "for raw_d in dirs:\n"
            "  d = os.path.expanduser(raw_d)\n"
            "  if not os.path.isdir(d): continue\n"
            "  for path in sorted(glob.glob(os.path.join(d, '*.desktop'))):\n"
            "    app_id = os.path.basename(path)[:-8]\n"
            "    if app_id in seen: continue\n"
            "    with open(path, encoding='utf-8', errors='ignore') as f: txt = f.read()\n"
            "    if 'NoDisplay=true' in txt or 'Type=Application' not in txt: continue\n"
            "    name = next((l.split('=', 1)[1].strip() for l in txt.splitlines() if l.startswith('Name=')), 'Unknown')\n"
            "    seen.add(app_id)\n"
            "    out.append([app_id, name])\n"
            "out.sort(key=lambda x: x[0])\n"
            "print(json.dumps(out))\n"
        )
        remote_cmd = f"python3 -c {shlex.quote(py_code)} {shlex.quote(dirs_json)}"
        raw = self.run_command(remote_cmd).decode("utf-8", errors="replace").strip()
        if not raw:
            return []
        try:
            return [(str(a), str(b)) for a, b in json.loads(raw)]
        except json.JSONDecodeError as exc:
            raise TransportError(f"Malformed application list from '{self.cfg.vm_target}': {exc}") from exc

    def read_desktop_file(self, app_id: str) -> str | None:
        clean_id = app_id[:-8] if app_id.endswith(".desktop") else app_id
        dirs_json = json.dumps(list(DESKTOP_APP_SEARCH_DIRS))
        py_code = (
            "import json, os, sys\n"
            "dirs = json.loads(sys.argv[1])\n"
            "clean_id = sys.argv[2]\n"
            "if '/' in clean_id or '..' in clean_id: sys.exit(1)\n"
            "for raw_d in dirs:\n"
            "  cand = os.path.join(os.path.expanduser(raw_d), clean_id + '.desktop')\n"
            "  if os.path.isfile(cand):\n"
            "    with open(cand, 'rb') as f: sys.stdout.buffer.write(f.read())\n"
            "    sys.exit(0)\n"
            "sys.exit(2)\n"
        )
        remote_cmd = f"python3 -c {shlex.quote(py_code)} {shlex.quote(dirs_json)} {shlex.quote(clean_id)}"
        raw = self.run_command(remote_cmd, check=False)
        text = raw.decode("utf-8", errors="replace").strip()
        return text if text else None

    def fetch_icon(self, icon_name: str) -> tuple[str, bytes] | None:
        if not icon_name:
            return None
        dirs_json = json.dumps(list(ICON_SEARCH_DIRS))
        py_code = (
            "import json, os, sys\n"
            "dirs = json.loads(sys.argv[1])\n"
            "icon = sys.argv[2]\n"
            "if os.path.isabs(icon) and os.path.isfile(icon):\n"
            "  sys.stdout.buffer.write(b'EXT:' + os.path.splitext(icon)[1].encode('ascii') + b'\\n' + open(icon, 'rb').read())\n"
            "  sys.exit(0)\n"
            "for raw_d in dirs:\n"
            "  d = os.path.expanduser(raw_d)\n"
            "  for ext in ('.svg', '.png', '.xpm'):\n"
            "    cand = os.path.join(d, icon + ext)\n"
            "    if os.path.isfile(cand):\n"
            "      sys.stdout.buffer.write(b'EXT:' + ext.encode('ascii') + b'\\n' + open(cand, 'rb').read())\n"
            "      sys.exit(0)\n"
        )
        remote_cmd = f"python3 -c {shlex.quote(py_code)} {shlex.quote(dirs_json)} {shlex.quote(icon_name)}"
        raw_data = self.run_command(remote_cmd, check=False)
        if not raw_data.startswith(b"EXT:") or b"\n" not in raw_data:
            return None
        header, icon_bytes = raw_data.split(b"\n", 1)
        ext = header.decode("ascii", errors="ignore").split(":", 1)[1]
        return (ext, icon_bytes) if icon_bytes else None

    def check_health(self) -> tuple[bool, str]:
        try:
            out = self.run_command("command -v waypipe && uname -m", check=True).decode("utf-8", errors="replace").strip()
            lines = [line.strip() for line in out.splitlines() if line.strip()]
            return True, f"SSH reachable ({', '.join(lines)})"
        except TransportError as exc:
            return False, str(exc)


class VsockControlTransport(ControlTransport):
    """Control plane over pure AF_VSOCK JSON-RPC to `wayport-daemon` (zero SSH)."""

    def _connect(self, timeout: float = 10.0) -> socket.socket:
        if self.cfg.vsock_cid is None:
            raise TransportError("Guest VSOCK CID is not configured.")
        try:
            sock = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
            sock.settimeout(timeout)
            sock.connect((self.cfg.vsock_cid, self.cfg.vsock_control_port))
            return sock
        except OSError as exc:
            raise TransportError(
                f"Cannot connect to guest AF_VSOCK CID {self.cfg.vsock_cid} port {self.cfg.vsock_control_port}: {exc}. "
                "Ensure the VM is running, Virtio VSOCK is attached, `wayport-guest.service` is active inside the VM "
                "(run `wayport install-guest`), and systemd lingering is enabled (`sudo loginctl enable-linger \"$USER\"`) "
                "if no user is logged into the VM."
            ) from exc

    def _rpc(self, payload: dict[str, Any], timeout: float = 15.0) -> dict[str, Any]:
        sock = self._connect(timeout=timeout)
        try:
            sock.sendall((json.dumps(payload, separators=(",", ":")) + "\n").encode("utf-8"))
            with sock.makefile("r", encoding="utf-8", errors="replace") as reader:
                raw_resp = reader.readline()
            if not raw_resp:
                raise TransportError("Empty response from guest VSOCK control daemon.")
            resp = json.loads(raw_resp)
            if not resp.get("ok"):
                raise TransportError(resp.get("error", "Guest VSOCK RPC failed"))
            return resp
        except json.JSONDecodeError as exc:
            raise TransportError(f"Invalid JSON from guest VSOCK daemon: {exc}") from exc
        except OSError as exc:
            raise TransportError(f"VSOCK RPC I/O error: {exc}") from exc
        finally:
            try:
                sock.close()
            except OSError:
                pass

    def open_session(self, payload: dict[str, Any], *, forward_output: bool = True) -> VsockSessionHandle:
        sock = self._connect(timeout=10.0)
        try:
            sock.settimeout(None)
            sock.sendall((json.dumps(payload, separators=(",", ":")) + "\n").encode("utf-8"))
            return VsockSessionHandle(sock, forward_output=forward_output)
        except OSError as exc:
            sock.close()
            raise TransportError(f"Failed to start VSOCK session: {exc}") from exc

    def _cache_marker_path(self) -> Path:
        script_hash = compute_guest_scripts_hash(self.cfg.vsock_control_port)
        return HOST_CACHE_DIR / f"vsock-sync-{script_hash}-{self.cfg.vm_slug}.json"

    def ensure_guest_scripts(self, force: bool = False) -> dict[str, Any]:
        HOST_CACHE_DIR.mkdir(parents=True, exist_ok=True)
        marker_file = self._cache_marker_path()
        if marker_file.exists() and not force:
            try:
                return json.loads(marker_file.read_text(encoding="utf-8"))
            except Exception:
                pass

        ping_info = self._rpc({"op": "ping"})
        if ALLOW_VSOCK_SCRIPT_SYNC and ping_info.get("allow_script_sync", True):
            self._rpc({
                "op": "sync_scripts",
                "scripts": {
                    GUEST_WRAPPER_NAME: render_guest_wrapper(),
                    GUEST_TRAY_AGENT_NAME: render_guest_tray_agent(),
                },
            })
        meta = {
            "hash": compute_guest_scripts_hash(self.cfg.vsock_control_port),
            "remote_runtime_dir": ping_info.get("runtime_dir", "/tmp"),
            "synced_at": int(time.time()),
        }
        marker_file.write_text(json.dumps(meta), encoding="utf-8")
        return meta

    def list_apps(self) -> list[tuple[str, str]]:
        resp = self._rpc({"op": "list_apps"})
        return [(str(item["id"]), str(item["name"])) for item in (resp.get("apps") or [])]

    def read_desktop_file(self, app_id: str) -> str | None:
        try:
            resp = self._rpc({"op": "get_desktop", "app_id": app_id})
            return str(resp.get("content", "")) or None
        except TransportError:
            return None

    def fetch_icon(self, icon_name: str) -> tuple[str, bytes] | None:
        if not icon_name:
            return None
        try:
            resp = self._rpc({"op": "get_icon", "icon_name": icon_name})
            return str(resp["ext"]), base64.b64decode(resp["b64"])
        except (TransportError, KeyError, ValueError):
            return None

    def check_health(self) -> tuple[bool, str]:
        try:
            info = self._rpc({"op": "ping"}, timeout=5.0)
            return True, f"VSOCK guest daemon reachable (version {info.get('version')}, uid {info.get('uid')})"
        except TransportError as exc:
            return False, str(exc)


def create_control_transport(cfg: RuntimeConfig) -> ControlTransport:
    if cfg.mode == "vsock":
        return VsockControlTransport(cfg)
    return SSHControlTransport(cfg)


