    signal.signal(signal.SIGINT, handle_stop)

    while not stop_event.is_set():
        try:
            conn, addr = server.accept()
        except OSError:
            break
        peer_cid = addr[0] if isinstance(addr, tuple) and addr else None
        threading.Thread(target=handle_client, args=(conn, peer_cid), daemon=True).start()


if __name__ == "__main__":
