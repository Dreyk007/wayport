    try:
        for raw_line in pipe:
            text = raw_line.decode("utf-8", errors="replace")
            if not _send_json(conn, lock, {"event": stream_name, "data": text}):
                break
    except Exception:
        pass


def handle_client(conn: socket.socket, peer_cid: int | None = None) -> None:
    send_lock = threading.Lock()
    try:
        if peer_cid is not None and peer_cid not in (VMADDR_CID_HOST, VMADDR_CID_LOCAL):
            log_msg(f"Rejected unauthorized VSOCK connection from CID {peer_cid}")
            _send_json(conn, send_lock, {"ok": False, "error": f"Unauthorized peer CID {peer_cid}"})
            return

        reader = conn.makefile("r", encoding="utf-8", errors="replace")
        raw_req = reader.readline()
        if not raw_req:
            return
        req = json.loads(raw_req)
        op = req.get("op", "")

        if op == "ping":
            uid = os.getuid()
            runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{uid}")
            _send_json(
                conn,
                send_lock,
                {
                    "ok": True,
                    "version": VERSION,
                    "uid": uid,
                    "runtime_dir": runtime_dir,
                    "allow_script_sync": ALLOW_SCRIPT_SYNC,
                },
            )
            return

        if op == "list_apps":
            _send_json(conn, send_lock, {"ok": True, "apps": list_desktop_apps()})
            return

        if op == "get_desktop":
            content = read_desktop_file(str(req.get("app_id", "")))
            if content is None:
                _send_json(conn, send_lock, {"ok": False, "error": "Desktop file not found"})
            else:
                _send_json(conn, send_lock, {"ok": True, "content": content})
            return

        if op == "get_icon":
            found = find_icon_file(str(req.get("icon_name", "")))
            if found is None:
                _send_json(conn, send_lock, {"ok": False, "error": "Icon not found"})
            else:
                ext, raw_bytes = found
                _send_json(
                    conn,
                    send_lock,
                    {"ok": True, "ext": ext, "b64": base64.b64encode(raw_bytes).decode("ascii")},
                )
            return

        if op == "sync_scripts":
            if not ALLOW_SCRIPT_SYNC:
                _send_json(conn, send_lock, {"ok": False, "error": "Script sync disabled by guest config"})
                return
            scripts = req.get("scripts") or {}
            GUEST_BIN_DIR.mkdir(parents=True, exist_ok=True)
            updated = []
            for name, content in scripts.items():
                if name not in ALLOWED_SYNC_FILES:
                    continue
                target = GUEST_BIN_DIR / name
                tmp = GUEST_BIN_DIR / f".{name}.tmp.{os.getpid()}"
                tmp.write_text(str(content), encoding="utf-8")
                tmp.chmod(0o755)
                tmp.replace(target)
                updated.append(name)
            _send_json(conn, send_lock, {"ok": True, "updated": updated})
            return

        if op == "run":
            vsock_port = int(req.get("vsock_port", 0))
            cmd_tokens = [str(tok) for tok in (req.get("cmd") or [])]
            compression = str(req.get("compression", "none"))
            no_gpu = bool(req.get("no_gpu", True))
            if vsock_port <= 0 or not cmd_tokens:
                _send_json(conn, send_lock, {"ok": False, "error": "Invalid vsock_port or cmd"})
                return

            wrapper_path = GUEST_BIN_DIR / "wayport-wrapper"
            full_cmd = [
                str(wrapper_path),
                "--vsock-port",
                str(vsock_port),
                "--compression",
                compression,
                "--no-gpu" if no_gpu else "--gpu",
                "--",
                *cmd_tokens,
            ]
            proc = subprocess.Popen(
                full_cmd,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                start_new_session=True,
            )
            _send_json(conn, send_lock, {"ok": True, "event": "started", "pid": proc.pid})

            t_out = threading.Thread(target=_stream_pipe, args=(proc.stdout, "stdout", conn, send_lock), daemon=True)
            t_err = threading.Thread(target=_stream_pipe, args=(proc.stderr, "stderr", conn, send_lock), daemon=True)
            t_out.start()
            t_err.start()

            # Watch for host disconnect or explicit cancel message
            def watch_host() -> None:
                try:
                    for line in reader:
                        if not line:
                            break
                        try:
                            msg = json.loads(line)
                            if msg.get("op") == "terminate":
                                _terminate_proc(proc)
                                break
                        except Exception:
                            pass
                except Exception:
                    pass
                finally:
                    _terminate_proc(proc)

            threading.Thread(target=watch_host, daemon=True).start()
            rc = proc.wait()
            t_out.join(timeout=1.0)
            t_err.join(timeout=1.0)
            _send_json(conn, send_lock, {"event": "exit", "code": rc})
            return

        if op == "start_tray":
            tray_port = int(req.get("vsock_port", 5001))
            agent_path = GUEST_BIN_DIR / "wayport-tray-agent"
            proc = subprocess.Popen(
                [str(agent_path), "--vsock", str(tray_port)],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                start_new_session=True,
            )
            _send_json(conn, send_lock, {"ok": True, "event": "started", "pid": proc.pid})
            t_err = threading.Thread(target=_stream_pipe, args=(proc.stderr, "stderr", conn, send_lock), daemon=True)
            t_err.start()

            def watch_tray_host() -> None:
                try:
                    for line in reader:
                        if not line:
                            break
                except Exception:
                    pass
                finally:
                    _terminate_proc(proc)

            threading.Thread(target=watch_tray_host, daemon=True).start()
            rc = proc.wait()
            t_err.join(timeout=1.0)
            _send_json(conn, send_lock, {"event": "exit", "code": rc})
            return

        _send_json(conn, send_lock, {"ok": False, "error": f"Unknown op: {op}"})
    except Exception as exc:
        _send_json(conn, send_lock, {"ok": False, "error": str(exc)})
    finally:
        try:
            conn.close()
        except OSError:
            pass


def main() -> None:
    port = CONTROL_PORT
    if len(sys.argv) >= 3 and sys.argv[1] == "--port":
        port = int(sys.argv[2])

