# ==============================================================================
# 2. Boundary-Safe Socket Stream Bridge (AF_VSOCK <-> AF_UNIX & AF_UNIX <-> AF_UNIX)
# ==============================================================================

def longest_matching_prefix_len(data: bytes, needle: bytes) -> int:
    """Returns the length of the longest suffix of `data` that is a proper prefix of `needle`."""
    max_k = min(len(data), len(needle) - 1)
    for k in range(max_k, 0, -1):
        if data.endswith(needle[:k]):
            return k
    return 0


def pump_socket_stream(
    src: socket.socket,
    dst: socket.socket,
    *,
    mask_idle_inhibit: bool = False,
    chunk_size: int = STREAM_CHUNK_SIZE,
) -> None:
    """
    Forwards bytes from `src` to `dst` until EOF.
    When `mask_idle_inhibit=True`, replaces the 27-byte Wayland global name
    `zwp_idle_inhibit_manager_v1` with `zwp_idle_inhibit_disabledv1`, even if
    the string is split across arbitrary `recv()` chunk boundaries.
    """
    pending = b""
    try:
        while True:
            chunk = src.recv(chunk_size)
            if not chunk:
                if pending:
                    dst.sendall(pending)
                    pending = b""
                break

            if mask_idle_inhibit:
                buf = pending + chunk
                if IDLE_INHIBIT_NEEDLE in buf:
                    buf = buf.replace(IDLE_INHIBIT_NEEDLE, IDLE_INHIBIT_REPLACEMENT)
                keep = longest_matching_prefix_len(buf, IDLE_INHIBIT_NEEDLE)
                if keep:
                    to_send, pending = buf[:-keep], buf[-keep:]
                else:
                    to_send, pending = buf, b""
                if to_send:
                    dst.sendall(to_send)
            else:
                dst.sendall(chunk)
    except OSError:
        pass
    finally:
        try:
            dst.shutdown(socket.SHUT_WR)
        except OSError:
            pass


def bridge_socket_pair(
    guest_conn: socket.socket,
    host_conn: socket.socket,
    *,
    mask_idle_inhibit: bool = False,
    chunk_size: int = STREAM_CHUNK_SIZE,
) -> tuple[threading.Thread, threading.Thread]:
    """
    Starts bidirectional pumping between `guest_conn` and `host_conn` and closes
    both file descriptors once both pump directions have completed.
    """
    state_lock = threading.Lock()
    remaining = [2]

    def run_direction(src: socket.socket, dst: socket.socket, mask: bool) -> None:
        try:
            pump_socket_stream(src, dst, mask_idle_inhibit=mask, chunk_size=chunk_size)
        finally:
            should_close = False
            with state_lock:
                remaining[0] -= 1
                if remaining[0] == 0:
                    should_close = True
            if should_close:
                for sock in (guest_conn, host_conn):
                    try:
                        sock.close()
                    except OSError:
                        pass

    t_g2h = threading.Thread(target=run_direction, args=(guest_conn, host_conn, False), daemon=True)
    t_h2g = threading.Thread(target=run_direction, args=(host_conn, guest_conn, mask_idle_inhibit), daemon=True)
    t_g2h.start()
    t_h2g.start()
    return t_g2h, t_h2g


def accept_and_bridge_loop(
    listener_sock: socket.socket,
    target_unix_sock_path: str,
    *,
    mask_idle_inhibit: bool = False,
    chunk_size: int = STREAM_CHUNK_SIZE,
) -> None:
    """
    Accepts connections on `listener_sock` (AF_VSOCK or AF_UNIX) and bridges
    each connection to the host `waypipe client` Unix socket.
    """
    while True:
        try:
            incoming_conn, _ = listener_sock.accept()
        except OSError:
            break

        try:
            unix_conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            unix_conn.connect(target_unix_sock_path)
        except OSError:
            try:
                incoming_conn.close()
            except OSError:
                pass
            continue

        bridge_socket_pair(
            incoming_conn,
            unix_conn,
            mask_idle_inhibit=mask_idle_inhibit,
            chunk_size=chunk_size,
        )


def create_vsock_listener(
    port_min: int = VSOCK_APP_PORT_MIN,
    port_max: int = VSOCK_APP_PORT_MAX,
) -> tuple[socket.socket, int]:
    """Binds a host AF_VSOCK listening socket on the first free port in [port_min, port_max)."""
    last_err: OSError | None = None
    for port in range(port_min, port_max):
        s = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
        try:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind((VMADDR_CID_ANY, port))
            s.listen(32)
            return s, port
        except OSError as exc:
            last_err = exc
            s.close()
            continue
    raise TransportError(
        f"Could not bind any host AF_VSOCK port in {port_min}..{port_max - 1} ({last_err}). "
        "Ensure 'vhost_vsock' is loaded (`sudo modprobe vhost_vsock`) and a Virtio VSOCK device is attached."
    )


def create_unix_listener(sock_path: Path) -> socket.socket:
    """Binds a host AF_UNIX listening socket with mode 0600."""
    sock_path.unlink(missing_ok=True)
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.bind(str(sock_path))
    os.chmod(sock_path, 0o600)
    s.listen(32)
    return s


