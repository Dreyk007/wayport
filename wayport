class TransportError(RuntimeError):
    """Raised when a host-to-guest transport operation fails."""


@dataclass(frozen=True)
class RuntimeConfig:
    """Resolved runtime configuration after merging defaults, env vars, and CLI flags."""

    mode: str
    vm_target: str
    vsock_cid: int | None
    vm_label: str
    vm_slug: str
    compression: str
    no_gpu: bool
    mask_idle_inhibit: bool
    vsock_control_port: int
    vsock_tray_port: int
    compression_explicit: bool = False
    no_gpu_explicit: bool = False

    @property
    def systemd_service_name(self) -> str:
        return f"wayport-tray-{self.vm_slug}.service"

    @property
    def effective_mask_idle_inhibit(self) -> bool:
        return self.mask_idle_inhibit and self.compression == "none"

    def cli_target_args(self) -> list[str]:
        """Builds canonical CLI flags to reproduce this config from .desktop or systemd."""
        args: list[str] = ["--mode", self.mode]
        if self.mode == "vsock":
            if self.vsock_cid is not None:
                args.extend(["--cid", str(self.vsock_cid)])
            if self.vm_label and self.vm_label != f"cid-{self.vsock_cid}":
                args.extend(["--target", self.vm_label])
        else:
            args.extend(["--target", self.vm_target])

        if self.compression_explicit:
            args.extend(["--compression", self.compression])
        if self.no_gpu_explicit:
            args.append("--no-gpu" if self.no_gpu else "--gpu")
        if self.vsock_control_port != VSOCK_CONTROL_PORT:
            args.extend(["--control-port", str(self.vsock_control_port)])
        if self.vsock_tray_port != VSOCK_TRAY_PORT:
            args.extend(["--tray-port", str(self.vsock_tray_port)])
        return args


def _parse_bool_env(name: str, default: bool) -> bool:
    raw = os.environ.get(name)
    if raw is None or raw == "":
        return default
    return raw.strip().lower() in ("1", "true", "yes", "on")


def _parse_int_env(name: str, default: int | None) -> int | None:
    raw = os.environ.get(name)
    if raw is None or raw.strip() == "":
        return default
    try:
        return int(raw.strip())
    except ValueError as exc:
        raise ValueError(f"Environment variable {name} must be an integer, got {raw!r}") from exc


def normalize_mode(raw_mode: str) -> str:
    mode = raw_mode.strip().lower()
    mode = MODE_ALIASES.get(mode, mode)
    if mode not in VALID_MODES:
        raise ValueError(
            f"Unsupported transport mode {raw_mode!r}. Expected one of: hybrid, vsock (socket), ssh."
        )
    return mode


def sanitize_vm_label(vm_target: str) -> str:
    """Extracts a human-readable host label from an SSH target or VSOCK URI."""
    cleaned = vm_target.strip()
    if cleaned.startswith("vsock://"):
        cleaned = f"cid-{cleaned[len('vsock://'):]}"
    elif cleaned.startswith("cid:"):
        cleaned = f"cid-{cleaned[len('cid:'):]}"
    return cleaned.split("@", 1)[-1]


def slugify_vm_label(label: str) -> str:
    """Converts a VM label into a safe filename / systemd unit identifier."""
    slug = re.sub(r"[^a-zA-Z0-9._-]+", "-", label.strip()).strip("-.")
    return slug or "default"


def build_runtime_config(
    *,
    mode: str | None = None,
    vm_target: str | None = None,
    vsock_cid: int | None = None,
    compression: str | None = None,
    no_gpu: bool | None = None,
    tray_port: int | None = None,
    control_port: int | None = None,
    mask_idle_inhibit: bool | None = None,
    require_target: bool = True,
) -> RuntimeConfig:
    """Merges CLI flags, WAYPORT_* environment variables, and top-of-file defaults."""
    env_mode = os.environ.get("WAYPORT_MODE")
    env_target = os.environ.get("WAYPORT_TARGET")
    env_cid = _parse_int_env("WAYPORT_CID", DEFAULT_VSOCK_CID)
    env_comp = os.environ.get("WAYPORT_COMPRESSION")

    raw_vm = vm_target if vm_target is not None else (env_target if env_target is not None else DEFAULT_TARGET)
    raw_vm = raw_vm.strip()
    resolved_cid = vsock_cid if vsock_cid is not None else env_cid

    inferred_vsock_from_uri = False
    if raw_vm.startswith("vsock://") or raw_vm.startswith("cid:"):
        cid_str = raw_vm.split("://", 1)[-1] if raw_vm.startswith("vsock://") else raw_vm.split(":", 1)[-1]
        if cid_str.isdigit():
            if resolved_cid is None:
                resolved_cid = int(cid_str)
            inferred_vsock_from_uri = True

    if mode is not None:
        resolved_mode = normalize_mode(mode)
    elif env_mode:
        resolved_mode = normalize_mode(env_mode)
    elif inferred_vsock_from_uri or (resolved_cid is not None and not raw_vm):
        resolved_mode = "vsock"
    else:
        resolved_mode = normalize_mode(DEFAULT_TRANSPORT_MODE)

    if resolved_mode == "vsock" and resolved_cid is None and raw_vm.isdigit():
        resolved_cid = int(raw_vm)

    if require_target:
        if resolved_mode == "vsock":
            if resolved_cid is None:
                raise ValueError(
                    "VSOCK mode requires a guest CID. Pass --cid <N> (or --target vsock://<N>) "
                    "or set DEFAULT_VSOCK_CID / WAYPORT_CID."
                )
            if resolved_cid < 3:
                raise ValueError(
                    f"Guest VSOCK CID must be >= 3 (0=hypervisor, 1=local, 2=host), got {resolved_cid}."
                )
        else:
            if not raw_vm:
                raise ValueError(
                    f"Mode '{resolved_mode}' requires a target. Pass --target user@host "
                    "or set DEFAULT_TARGET / WAYPORT_TARGET."
                )

    if resolved_mode == "vsock":
        if raw_vm and not raw_vm.isdigit() and not raw_vm.startswith(("vsock://", "cid:")):
            vm_label = sanitize_vm_label(raw_vm)
        elif resolved_cid is not None:
            vm_label = f"cid-{resolved_cid}"
        else:
            vm_label = "vsock"
    else:
        vm_label = sanitize_vm_label(raw_vm) if raw_vm else "vm"

    comp_explicit = compression is not None
    raw_comp = compression if compression is not None else (env_comp or "")
    if raw_comp:
        resolved_comp = raw_comp.strip().lower()
        if resolved_comp not in VALID_COMPRESSIONS:
            raise ValueError(f"Unsupported compression {raw_comp!r}. Choose from: none, lz4, zstd.")
    else:
        resolved_comp = WAYPIPE_COMPRESSION_SSH if resolved_mode == "ssh" else WAYPIPE_COMPRESSION_VSOCK

    no_gpu_explicit = no_gpu is not None
    if no_gpu is not None:
        resolved_no_gpu = no_gpu
    elif os.environ.get("WAYPORT_NO_GPU") is not None:
        resolved_no_gpu = _parse_bool_env("WAYPORT_NO_GPU", True)
    else:
        resolved_no_gpu = WAYPIPE_NO_GPU_SSH if resolved_mode == "ssh" else WAYPIPE_NO_GPU_VSOCK

    resolved_mask = (
        mask_idle_inhibit
        if mask_idle_inhibit is not None
        else _parse_bool_env("WAYPORT_MASK_IDLE_INHIBIT", MASK_IDLE_INHIBIT)
    )
    resolved_ctrl_port = (
        control_port
        if control_port is not None
        else (_parse_int_env("WAYPORT_CONTROL_PORT", VSOCK_CONTROL_PORT) or VSOCK_CONTROL_PORT)
    )
    resolved_tray_port = (
        tray_port
        if tray_port is not None
        else (_parse_int_env("WAYPORT_TRAY_PORT", VSOCK_TRAY_PORT) or VSOCK_TRAY_PORT)
    )

    return RuntimeConfig(
        mode=resolved_mode,
        vm_target=raw_vm,
        vsock_cid=resolved_cid,
        vm_label=vm_label,
        vm_slug=slugify_vm_label(vm_label),
        compression=resolved_comp,
        no_gpu=resolved_no_gpu,
        mask_idle_inhibit=resolved_mask,
        vsock_control_port=resolved_ctrl_port,
        vsock_tray_port=resolved_tray_port,
        compression_explicit=comp_explicit,
        no_gpu_explicit=no_gpu_explicit,
    )


