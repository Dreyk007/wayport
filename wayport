    class HostProxiedTrayItem:
        _counter = 0

        def __init__(self, item_key: str, state: dict, menu_data: dict | None, send_fn) -> None:
            HostProxiedTrayItem._counter += 1
            self.conn = dbus.SessionBus(private=True)
            self.bus_name_str = f"org.kde.StatusNotifierItem-{os.getpid()}-{HostProxiedTrayItem._counter}"
            self.bus_name = dbus.service.BusName(self.bus_name_str, bus=self.conn)
            self.sni_obj = HostSNIObject(self.conn, item_key, state, send_fn)
            self.menu_obj = HostDbusMenuObject(self.conn, item_key, send_fn)
            if menu_data:
                self.menu_obj.update_menu(menu_data)
            self.register_with_host_watcher()

        def register_with_host_watcher(self) -> None:
            try:
                watcher = self.conn.get_object(SNW_BUS_NAME, SNW_OBJ_PATH)
                dbus.Interface(watcher, SNW_IFACE).RegisterStatusNotifierItem(self.bus_name_str)
            except Exception as exc:
                print(f"[TRAY-WARN] Failed to register with host StatusNotifierWatcher: {exc}", file=sys.stderr)

        def close(self) -> None:
            try:
                self.sni_obj.remove_from_connection()
                self.menu_obj.remove_from_connection()
                del self.bus_name
                self.conn.close()
            except Exception:
                pass

    class HostTrayBridgeManager:
        def __init__(self) -> None:
            self.host_bus = dbus.SessionBus()
            self.proxied_items: dict[str, HostProxiedTrayItem] = {}
            self.active_writer: Any = None
            self.write_lock = threading.Lock()
            self.stop_event = threading.Event()

        def send_to_guest(self, payload: dict) -> None:
            line = (json.dumps(payload, separators=(",", ":")) + "\n").encode("utf-8")
            with self.write_lock:
                writer = self.active_writer
                if writer is None:
                    return
                try:
                    if isinstance(writer, socket.socket):
                        writer.sendall(line)
                    else:
                        writer.write(line)
                        writer.flush()
                except Exception:
                    pass

        def forward_notification_to_host(self, msg: dict) -> None:
            try:
                notif_obj = self.host_bus.get_object(NOTIF_BUS_NAME, NOTIF_OBJ_PATH)
                notif_iface = dbus.Interface(notif_obj, NOTIF_IFACE)
                app_name = format_badge(msg.get("app_name") or "VM App", vm_label)
                notif_iface.Notify(
                    dbus.String(app_name),
                    dbus.UInt32(0),
                    dbus.String(msg.get("app_icon") or ""),
                    dbus.String(msg.get("summary") or app_name),
                    dbus.String(msg.get("body") or ""),
                    dbus.Array([], signature="s"),
                    dbus.Dictionary({}, signature="sv"),
                    dbus.Int32(int(msg.get("timeout", -1))),
                )
            except Exception as exc:
                print(f"[TRAY-WARN] Failed to forward notification to host: {exc}", file=sys.stderr)

        def handle_guest_message(self, msg: dict) -> bool:
            ev = msg.get("event")
            if ev == "notify":
                self.forward_notification_to_host(msg)
                return False

            key = msg.get("key", "")
            if not key:
                return False

            if ev == "item_added":
                if key in self.proxied_items:
                    self.proxied_items.pop(key).close()
                state = msg.get("state") or {}
                menu = msg.get("menu")
                self.proxied_items[key] = HostProxiedTrayItem(key, state, menu, self.send_to_guest)
                print(f"[TRAY] Mirrored VM tray icon ({cfg.mode}): '{state.get('Title') or state.get('Id')}' ({key})")
            elif ev == "item_updated":
                item = self.proxied_items.get(key)
                if item and "state" in msg:
                    item.sni_obj.apply_state(msg["state"], emit_signals=True)
            elif ev == "menu_updated":
                item = self.proxied_items.get(key)
                if item and "menu" in msg:
                    item.menu_obj.update_menu(msg["menu"])
            elif ev == "item_removed":
                item = self.proxied_items.pop(key, None)
                if item:
                    item.close()
                    print(f"[TRAY] Removed VM tray icon from host: {key}")
            return False

        def clear_all_items(self) -> bool:
            for key in list(self.proxied_items.keys()):
                self.proxied_items.pop(key).close()
            return False

        def _consume_tray_lines(self, reader) -> None:
            for raw_line in reader:
                if self.stop_event.is_set():
                    break
                if isinstance(raw_line, bytes):
                    line = raw_line.decode("utf-8", errors="replace").strip()
                else:
                    line = raw_line.strip()
                if line.startswith("TRAY_JSON:"):
                    try:
                        payload = json.loads(line[10:])
                        GLib.idle_add(self.handle_guest_message, payload)
                    except json.JSONDecodeError:
                        continue

        def _worker_ssh_stdio(self) -> None:
            print(f"[TRAY] Starting pure-SSH stdio tray bridge for '{cfg.vm_target}'...")
            while not self.stop_event.is_set():
                proc: subprocess.Popen | None = None
                try:
                    transport.ensure_guest_scripts(force=False)
                    ssh_cmd = _build_ssh_base_cmd(cfg.vm_target, disable_mux=True) + [
                        f"{GUEST_BIN_DIR}/{GUEST_TRAY_AGENT_NAME} --stdio"
                    ]
                    proc = subprocess.Popen(
                        ssh_cmd,
                        stdin=subprocess.PIPE,
                        stdout=subprocess.PIPE,
                        stderr=sys.stderr,
                    )
                    assert proc.stdin is not None and proc.stdout is not None
                    with self.write_lock:
                        self.active_writer = proc.stdin
                    print(f"[TRAY] Connected to guest tray agent via SSH stdio ({cfg.vm_target})")
                    self._consume_tray_lines(proc.stdout)
                except Exception as exc:
                    print(f"[TRAY-WARN] SSH tray session ended: {exc}", file=sys.stderr)
                finally:
                    with self.write_lock:
                        self.active_writer = None
                    if proc is not None:
                        terminate_handle_cleanly(PopenHandle(proc))
                    GLib.idle_add(self.clear_all_items)
                self.stop_event.wait(TRAY_RECONNECT_DELAY_SEC)

        def _worker_vsock(self) -> None:
            server_sock = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
            server_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                server_sock.bind((VMADDR_CID_ANY, cfg.vsock_tray_port))
                server_sock.listen(4)
            except OSError as exc:
                print(
                    f"[TRAY-ERROR] Cannot bind host AF_VSOCK port {cfg.vsock_tray_port}: {exc}. "
                    "Another wayport-tray-*.service may already use this port (stop it or pass --tray-port <PORT>).",
                    file=sys.stderr,
                )
                server_sock.close()
                GLib.idle_add(loop.quit)
                return
            server_sock.settimeout(TRAY_ACCEPT_TIMEOUT_SEC)
            print(f"[TRAY] Listening on host AF_VSOCK (CID ANY, port {cfg.vsock_tray_port}, mode={cfg.mode})...")

            try:
                while not self.stop_event.is_set():
                    trigger_handle: ManagedProcessHandle | None = None
                    conn: socket.socket | None = None
                    try:
                        transport.ensure_guest_scripts(force=False)
                        if cfg.mode == "vsock":
                            assert isinstance(transport, VsockControlTransport)
                            trigger_handle = transport.open_session(
                                {"op": "start_tray", "vsock_port": cfg.vsock_tray_port},
                                forward_output=True,
                            )
                        else:
                            ssh_cmd = _build_ssh_base_cmd(cfg.vm_target, disable_mux=True) + [
                                f"{GUEST_BIN_DIR}/{GUEST_TRAY_AGENT_NAME} --vsock {cfg.vsock_tray_port}"
                            ]
                            trigger_handle = PopenHandle(
                                subprocess.Popen(
                                    ssh_cmd,
                                    stdin=subprocess.DEVNULL,
                                    stdout=subprocess.DEVNULL,
                                    stderr=sys.stderr,
                                )
                            )

                        conn, addr = server_sock.accept()
                        print(f"[TRAY] Accepted AF_VSOCK tray connection from guest CID {addr[0]}:{addr[1]}")
                        with self.write_lock:
                            self.active_writer = conn

                        with conn.makefile("r", encoding="utf-8", errors="replace") as reader:
                            self._consume_tray_lines(reader)
                    except socket.timeout:
                        print("[TRAY-WARN] Timed out waiting for guest AF_VSOCK connection.", file=sys.stderr)
                    except Exception as exc:
                        print(f"[TRAY-WARN] VSOCK tray session ended: {exc}", file=sys.stderr)
                    finally:
                        with self.write_lock:
                            self.active_writer = None
                        if conn is not None:
                            try:
                                conn.close()
                            except OSError:
                                pass
                        terminate_handle_cleanly(trigger_handle)
                        GLib.idle_add(self.clear_all_items)
                    self.stop_event.wait(TRAY_RECONNECT_DELAY_SEC)
            finally:
                try:
                    server_sock.close()
                except OSError:
                    pass

        def run_worker(self) -> None:
            if cfg.mode == "ssh":
                self._worker_ssh_stdio()
            else:
                self._worker_vsock()

    manager = HostTrayBridgeManager()
    loop = GLib.MainLoop()

    def handle_stop(_signum, _frame) -> None:
        manager.stop_event.set()
        GLib.idle_add(manager.clear_all_items)
        GLib.idle_add(loop.quit)

    signal.signal(signal.SIGTERM, handle_stop)
    signal.signal(signal.SIGINT, handle_stop)

    threading.Thread(target=manager.run_worker, daemon=True).start()
    try:
        loop.run()
    except KeyboardInterrupt:
        manager.stop_event.set()
        manager.clear_all_items()


