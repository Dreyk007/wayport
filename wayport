def rgba_to_argb32(
    pixels: bytes,
    w: int,
    h: int,
    rowstride: int,
    n_channels: int,
    has_alpha: bool,
) -> bytes:
    """Vectorized row-slice conversion from GdkPixbuf RGB/RGBA to SNI ARGB32."""
    out = bytearray(w * h * 4)
    row_bytes = w * n_channels
    alpha_full = b"\xff" * w
    for y in range(h):
        src_start = y * rowstride
        row = pixels[src_start : src_start + row_bytes]
        dst_start = y * w * 4
        dst_end = dst_start + w * 4
        if has_alpha and n_channels >= 4:
            out[dst_start:dst_end:4] = row[3::n_channels]
            out[dst_start + 1 : dst_end : 4] = row[0::n_channels]
            out[dst_start + 2 : dst_end : 4] = row[1::n_channels]
            out[dst_start + 3 : dst_end : 4] = row[2::n_channels]
        else:
            out[dst_start:dst_end:4] = alpha_full
            out[dst_start + 1 : dst_end : 4] = row[0::n_channels]
            out[dst_start + 2 : dst_end : 4] = row[1::n_channels]
            out[dst_start + 3 : dst_end : 4] = row[2::n_channels]
    return bytes(out)


def file_to_argb32_pixmap(file_path: Path, size: int = ICON_SIZE) -> dict | None:
    if not HAS_GDKPIXBUF or not file_path.is_file():
        return None
    try:
        pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(file_path), size, size, True)
        if not pixbuf:
            return None
        w = pixbuf.get_width()
        h = pixbuf.get_height()
        argb = rgba_to_argb32(
            pixbuf.get_pixels(),
            w,
            h,
            pixbuf.get_rowstride(),
            pixbuf.get_n_channels(),
            pixbuf.get_has_alpha(),
        )
        return {"w": w, "h": h, "b64": base64.b64encode(argb).decode("ascii")}
    except Exception:
        return None


def locate_and_collect_icons(icon_theme_path: str, icon_name: str) -> tuple[dict[str, str], list[dict]]:
    files: dict[str, str] = {}
    fallback_pixmaps: list[dict] = []
    candidate_files: list[Path] = []

    if icon_theme_path:
        theme_dir = Path(icon_theme_path)
        if theme_dir.is_dir() and not is_system_icon_dir(theme_dir):
            count = 0
            for path in sorted(theme_dir.rglob("*")):
                if count >= MAX_THEME_FILES:
                    break
                if path.is_file() and path.suffix.lower() in (".png", ".svg", ".xpm"):
                    try:
                        if path.stat().st_size <= MAX_ICON_BYTES:
                            rel = str(path.relative_to(theme_dir))
                            files[rel] = base64.b64encode(path.read_bytes()).decode("ascii")
                            candidate_files.append(path)
                            count += 1
                    except OSError:
                        pass

    if icon_name:
        if os.path.isabs(icon_name):
            p = Path(icon_name)
            if p.is_file():
                candidate_files.insert(0, p)
                try:
                    if p.stat().st_size <= MAX_ICON_BYTES:
                        files[p.name] = base64.b64encode(p.read_bytes()).decode("ascii")
                except OSError:
                    pass
        elif not candidate_files:
            for d in ICON_SEARCH_DIRS:
                expanded = Path(os.path.expanduser(d))
                for ext in (".png", ".svg", ".xpm"):
                    cand = expanded / f"{icon_name}{ext}"
                    if cand.is_file():
                        candidate_files.append(cand)
                        try:
                            if cand.stat().st_size <= MAX_ICON_BYTES:
                                files[cand.name] = base64.b64encode(cand.read_bytes()).decode("ascii")
                        except OSError:
                            pass
                        break
                if candidate_files:
                    break

    if candidate_files:
        best_file = candidate_files[0]
        if icon_name:
            stem = Path(icon_name).stem
            for c in candidate_files:
                if c.stem == stem or c.name == icon_name:
                    best_file = c
                    break
        px = file_to_argb32_pixmap(best_file, size=ICON_SIZE)
        if px:
            fallback_pixmaps.append(px)

    return files, fallback_pixmaps


def serialize_dbus_variant(val) -> dict:
    if isinstance(val, dbus.Boolean):
        return {"t": "b", "v": bool(val)}
    if isinstance(val, (dbus.Int16, dbus.Int32, dbus.Int64, dbus.UInt16, dbus.UInt32, dbus.UInt64)):
        return {"t": "i", "v": int(val)}
    if isinstance(val, (dbus.ByteArray, bytes, bytearray)):
        return {"t": "ay", "v": base64.b64encode(bytes(val)).decode("ascii")}
    if isinstance(val, dbus.Array):
        if getattr(val, "signature", "") == "y" or (len(val) > 0 and isinstance(val[0], dbus.Byte)):
            return {"t": "ay", "v": base64.b64encode(bytes(val)).decode("ascii")}
        rows = []
        for row in val:
            if isinstance(row, (list, tuple, dbus.Array)):
                rows.append([str(x) for x in row])
        return {"t": "aas", "v": rows}
    return {"t": "s", "v": str(val)}


def serialize_menu_node(node) -> dict:
    item_id = int(node[0])
    raw_props = node[1]
    raw_children = node[2]

    props = {str(k): serialize_dbus_variant(v) for k, v in raw_props.items()}
    children = []
    for child in raw_children:
        try:
            children.append(serialize_menu_node(child))
        except Exception:
            continue
    return {"id": item_id, "props": props, "children": children}


