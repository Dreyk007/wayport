def sync_theme_files_safe(
    target_dir: Path,
    theme_files: dict[str, str],
) -> str:
    """Safely writes base64-encoded theme icon files inside `target_dir`, rejecting path traversal."""
    if not theme_files:
        return ""
    target_dir.mkdir(parents=True, exist_ok=True)
    resolved_root = target_dir.resolve()
    for rel_path, b64_data in theme_files.items():
        safe_rel = Path(rel_path)
        if safe_rel.is_absolute() or ".." in safe_rel.parts:
            continue
        dest = (resolved_root / safe_rel).resolve()
        if not dest.is_relative_to(resolved_root) or dest == resolved_root:
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        try:
            dest.write_bytes(base64.b64decode(b64_data))
        except Exception:
            pass
    return str(resolved_root)


def run_host_tray_daemon(cfg: RuntimeConfig) -> None:
    """
    Runs the host-side KDE StatusNotifierItem, DbusMenu & Notification bridge daemon.
    Supports `hybrid` (AF_VSOCK + SSH trigger), `vsock` (pure AF_VSOCK), and `ssh` (stdio).
    """
    import dbus
    import dbus.service
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib

    DBusGMainLoop(set_as_default=True)
    vm_label = cfg.vm_label
    transport = create_control_transport(cfg)

    SNW_BUS_NAME = "org.kde.StatusNotifierWatcher"
    SNW_OBJ_PATH = "/StatusNotifierWatcher"
    SNW_IFACE = "org.kde.StatusNotifierWatcher"
    SNI_IFACE = "org.kde.StatusNotifierItem"
    DBUSMENU_IFACE = "com.canonical.dbusmenu"

    NOTIF_BUS_NAME = "org.freedesktop.Notifications"
    NOTIF_OBJ_PATH = "/org/freedesktop/Notifications"
    NOTIF_IFACE = "org.freedesktop.Notifications"

    def pack_pixmap_array(px_list: list[dict]) -> dbus.Array:
        arr = dbus.Array([], signature="(iiay)")
        for item in px_list or []:
            try:
                raw_bytes = base64.b64decode(item["b64"])
                arr.append(
                    dbus.Struct(
                        (dbus.Int32(item["w"]), dbus.Int32(item["h"]), dbus.ByteArray(raw_bytes)),
                        signature="iiay",
                    )
                )
            except Exception:
                continue
        return arr

    def unpack_menu_variant(tagged: dict):
        t = tagged.get("t", "s")
        v = tagged.get("v")
        if t == "b":
            return dbus.Boolean(bool(v), variant_level=1)
        if t == "i":
            return dbus.Int32(int(v), variant_level=1)
        if t == "ay":
            return dbus.ByteArray(base64.b64decode(v), variant_level=1)
        if t == "aas":
            outer = dbus.Array([], signature="as", variant_level=1)
            for row in v or []:
                outer.append(dbus.Array([dbus.String(s) for s in row], signature="s"))
            return outer
        return dbus.String(str(v if v is not None else ""), variant_level=1)

    def build_dbusmenu_struct(node: dict, is_root: bool = True) -> dbus.Struct:
        item_id = dbus.Int32(node.get("id", 0))
        props = dbus.Dictionary({}, signature="sv")
        for k, tagged_val in node.get("props", {}).items():
            props[dbus.String(k)] = unpack_menu_variant(tagged_val)

        children = dbus.Array(
            [build_dbusmenu_struct(c, is_root=False) for c in node.get("children", [])],
            signature="v",
        )
        return dbus.Struct(
            (item_id, props, children),
            signature="ia{sv}av",
            variant_level=0 if is_root else 1,
        )

    def find_menu_subtree(node: dict, target_id: int) -> dict | None:
        if node.get("id", 0) == target_id:
            return node
        for child in node.get("children", []):
            found = find_menu_subtree(child, target_id)
            if found is not None:
                return found
        return None

    class HostDbusMenuObject(dbus.service.Object):
        def __init__(self, conn: dbus.Bus, item_key: str, send_fn) -> None:
            super().__init__(conn, "/MenuBar")
            self.item_key = item_key
            self.send_fn = send_fn
            self.revision = 1
            self.root_node = {"id": 0, "props": {"children-display": {"t": "s", "v": "submenu"}}, "children": []}

        def update_menu(self, menu_data: dict | None) -> None:
            if not menu_data or "root" not in menu_data:
                return
            self.revision = int(menu_data.get("revision", self.revision + 1))
            self.root_node = menu_data["root"]
            self.LayoutUpdated(dbus.UInt32(self.revision), dbus.Int32(0))

        @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="ss", out_signature="v")
        def Get(self, interface_name: str, property_name: str):
            return self.GetAll(interface_name).get(property_name, dbus.String("", variant_level=1))

        @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="s", out_signature="a{sv}")
        def GetAll(self, interface_name: str) -> dbus.Dictionary:
            if interface_name == DBUSMENU_IFACE:
                return dbus.Dictionary(
                    {
                        "Version": dbus.UInt32(3, variant_level=1),
                        "TextDirection": dbus.String("ltr", variant_level=1),
                        "Status": dbus.String("normal", variant_level=1),
                        "IconThemePath": dbus.Array([], signature="s", variant_level=1),
                    },
                    signature="sv",
                )
            return dbus.Dictionary({}, signature="sv")

        @dbus.service.method(DBUSMENU_IFACE, in_signature="iias", out_signature="u(ia{sv}av)")
        def GetLayout(self, parent_id: int, recursion_depth: int, property_names: list):
            target = find_menu_subtree(self.root_node, int(parent_id)) or self.root_node
            return dbus.UInt32(self.revision), build_dbusmenu_struct(target, is_root=True)

        @dbus.service.method(DBUSMENU_IFACE, in_signature="aias", out_signature="a(ia{sv})")
        def GetGroupProperties(self, ids: list, property_names: list):
            result = dbus.Array([], signature="(ia{sv})")
            for req_id in ids:
                node = find_menu_subtree(self.root_node, int(req_id))
                if node:
                    props = dbus.Dictionary({}, signature="sv")
                    for k, tagged_val in node.get("props", {}).items():
                        props[dbus.String(k)] = unpack_menu_variant(tagged_val)
                    result.append(dbus.Struct((dbus.Int32(req_id), props), signature="ia{sv}"))
            return result

        @dbus.service.method(DBUSMENU_IFACE, in_signature="is", out_signature="v")
        def GetProperty(self, item_id: int, name: str):
            node = find_menu_subtree(self.root_node, int(item_id))
            if node and name in node.get("props", {}):
                return unpack_menu_variant(node["props"][name])
            return dbus.String("", variant_level=1)

        @dbus.service.method(DBUSMENU_IFACE, in_signature="isvu", out_signature="")
        def Event(self, item_id: int, event_id: str, data, timestamp: int) -> None:
            if str(event_id) == "clicked":
                self.send_fn({
                    "cmd": "MenuEvent",
                    "key": self.item_key,
                    "menu_id": int(item_id),
                    "event_id": "clicked",
                    "timestamp": int(timestamp),
                })

        @dbus.service.method(DBUSMENU_IFACE, in_signature="a(isvu)", out_signature="ai")
        def EventGroup(self, events: list):
            for ev in events:
                try:
                    item_id, event_id, _, timestamp = int(ev[0]), str(ev[1]), ev[2], int(ev[3])
                    if event_id == "clicked":
                        self.send_fn({
                            "cmd": "MenuEvent",
                            "key": self.item_key,
                            "menu_id": item_id,
                            "event_id": "clicked",
                            "timestamp": timestamp,
                        })
                except Exception:
                    continue
            return dbus.Array([], signature="i")

        @dbus.service.method(DBUSMENU_IFACE, in_signature="i", out_signature="b")
        def AboutToShow(self, item_id: int) -> dbus.Boolean:
            self.send_fn({"cmd": "AboutToShow", "key": self.item_key, "menu_id": int(item_id)})
            return dbus.Boolean(False)

        @dbus.service.method(DBUSMENU_IFACE, in_signature="ai", out_signature="aiai")
        def AboutToShowGroup(self, ids: list):
            for i in ids:
                self.send_fn({"cmd": "AboutToShow", "key": self.item_key, "menu_id": int(i)})
            return dbus.Array([], signature="i"), dbus.Array([], signature="i")

        @dbus.service.signal(DBUSMENU_IFACE, signature="ui")
        def LayoutUpdated(self, revision: int, parent: int) -> None:
            pass

        @dbus.service.signal(DBUSMENU_IFACE, signature="a(ia{sv})a(ias)")
        def ItemsPropertiesUpdated(self, updated_props, removed_props) -> None:
            pass

    class HostSNIObject(dbus.service.Object):
        def __init__(self, conn: dbus.Bus, item_key: str, state: dict, send_fn) -> None:
            super().__init__(conn, "/StatusNotifierItem")
            self.item_key = item_key
            self.send_fn = send_fn
            self.host_theme_dir = ""
            self.state: dict = {}
            self.apply_state(state, emit_signals=False)

        def sync_theme_files(self, state: dict) -> str:
            if "ThemeFiles" not in state:
                return self.host_theme_dir
            theme_files = state.get("ThemeFiles") or {}
            if not theme_files:
                return ""
            key_hash = hashlib.sha1(f"{vm_label}:{self.item_key}".encode("utf-8")).hexdigest()[:12]
            return sync_theme_files_safe(HOST_TRAY_ICONS_DIR / key_hash, theme_files)

        def apply_state(self, new_state: dict, emit_signals: bool = True) -> None:
            self.host_theme_dir = self.sync_theme_files(new_state)
            self.state = new_state
            if emit_signals:
                self.NewIcon()
                self.NewAttentionIcon()
                self.NewOverlayIcon()
                self.NewTitle()
                self.NewToolTip()
                self.NewStatus(dbus.String(self.state.get("Status") or "Active"))

        def build_properties(self) -> dbus.Dictionary:
            raw_name = self.state.get("Title") or self.state.get("Id") or "VM Application"
            title_raw = re.sub(r"_status_icon_\d+$", "", raw_name)
            badge_title = format_badge(title_raw, vm_label)

            tt = self.state.get("ToolTip") or {}
            tt_title = format_badge(re.sub(r"_status_icon_\d+$", "", tt.get("title") or title_raw), vm_label)

            tt_struct = dbus.Struct(
                (
                    dbus.String(tt.get("icon_name") or ""),
                    pack_pixmap_array(tt.get("pixmaps") or []),
                    dbus.String(tt_title),
                    dbus.String(tt.get("desc") or ""),
                ),
                signature="sa(iiay)ss",
                variant_level=1,
            )

            has_menu = bool(self.state.get("MenuPath"))
            key_hash = hashlib.sha1(f"{vm_label}:{self.item_key}".encode("utf-8")).hexdigest()[:8]

            props = {
                "Category": dbus.String(self.state.get("Category") or "ApplicationStatus", variant_level=1),
                "Id": dbus.String(f"vm_{key_hash}_{self.state.get('Id', 'app')}", variant_level=1),
                "Title": dbus.String(badge_title, variant_level=1),
                "Status": dbus.String(self.state.get("Status") or "Active", variant_level=1),
                "WindowId": dbus.Int32(int(self.state.get("WindowId") or 0), variant_level=1),
                "IconThemePath": dbus.String(self.host_theme_dir, variant_level=1),
                "IconName": dbus.String(self.state.get("IconName") or "", variant_level=1),
                "IconPixmap": pack_pixmap_array(self.state.get("IconPixmap") or []),
                "OverlayIconName": dbus.String(self.state.get("OverlayIconName") or "", variant_level=1),
                "OverlayIconPixmap": pack_pixmap_array(self.state.get("OverlayIconPixmap") or []),
                "AttentionIconName": dbus.String(self.state.get("AttentionIconName") or "", variant_level=1),
                "AttentionIconPixmap": pack_pixmap_array(self.state.get("AttentionIconPixmap") or []),
                "AttentionMovieName": dbus.String(self.state.get("AttentionMovieName") or "", variant_level=1),
                "ToolTip": tt_struct,
                "ItemIsMenu": dbus.Boolean(bool(self.state.get("ItemIsMenu", False)), variant_level=1),
                "Menu": dbus.ObjectPath("/MenuBar" if has_menu else "/NO_DBUSMENU", variant_level=1),
            }
            return dbus.Dictionary(props, signature="sv")

        @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="ss", out_signature="v")
        def Get(self, interface_name: str, property_name: str):
            if interface_name == SNI_IFACE:
                props = self.build_properties()
                if property_name in props:
                    return props[property_name]
            return dbus.String("", variant_level=1)

        @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="s", out_signature="a{sv}")
        def GetAll(self, interface_name: str) -> dbus.Dictionary:
            if interface_name == SNI_IFACE:
                return self.build_properties()
            return dbus.Dictionary({}, signature="sv")

        @dbus.service.method(SNI_IFACE, in_signature="ii", out_signature="")
        def Activate(self, x: int, y: int) -> None:
