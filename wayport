def _add_common_transport_args(target_parser: argparse.ArgumentParser, *, suppress_defaults: bool = False) -> None:
    default_val = argparse.SUPPRESS if suppress_defaults else None
    target_parser.add_argument(
        "-m",
        "--mode",
        choices=("hybrid", "vsock", "socket", "ssh"),
        default=default_val,
        help=f"Transport mode: hybrid (SSH control + VSOCK data), vsock/socket (pure VSOCK), ssh (pure SSH). Default: {DEFAULT_TRANSPORT_MODE}",
    )
    target_parser.add_argument(
        "-t",
        "--target",
        dest="target",
        default=default_val,
        help="Remote SSH target (user@host) for hybrid/ssh modes, or optional label / vsock://<CID> in vsock mode",
    )
    target_parser.add_argument(
        "--cid",
        type=int,
        default=default_val,
        help="Guest AF_VSOCK CID (>= 3) for pure vsock/socket mode",
    )
    target_parser.add_argument(
        "-c",
        "--compression",
        choices=VALID_COMPRESSIONS,
        default=default_val,
        help=f"Waypipe compression (default: {WAYPIPE_COMPRESSION_VSOCK} for hybrid/vsock, {WAYPIPE_COMPRESSION_SSH} for ssh)",
    )
    gpu_group = target_parser.add_mutually_exclusive_group()
    gpu_group.add_argument("--no-gpu", dest="no_gpu", action="store_true", default=default_val, help="Pass --no-gpu to waypipe")
    gpu_group.add_argument("--gpu", dest="no_gpu", action="store_false", default=default_val, help="Allow GPU/DMABUF transfers in waypipe")
    target_parser.add_argument(
        "--control-port",
        type=int,
        default=default_val,
        help=f"Guest AF_VSOCK control RPC port for vsock mode (default: {VSOCK_CONTROL_PORT})",
    )
    target_parser.add_argument(
        "--tray-port",
        type=int,
        default=default_val,
        help=f"Host AF_VSOCK tray bridge port (default: {VSOCK_TRAY_PORT})",
    )
    target_parser.add_argument(
        "--no-tray",
        action="store_true",
        default=argparse.SUPPRESS if suppress_defaults else False,
        help="Do not auto-start or modify the host systemd tray service during `run`",
    )


def build_arg_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="wayport",
        description=(
            "Seamless KVM & remote Linux application exporter, runner, System Tray "
            "& Desktop Notification bridge for KDE Plasma 6 (Wayland)."
        ),
    )
    parser.add_argument(
        "-v",
        "--version",
        action="version",
        version=f"%(prog)s {__version__} (scripts:{compute_guest_scripts_hash()})",
    )
    _add_common_transport_args(parser, suppress_defaults=False)

    common_sub = argparse.ArgumentParser(add_help=False)
    _add_common_transport_args(common_sub, suppress_defaults=True)

    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("list", parents=[common_sub], help="List available GUI applications inside the guest")

    export_parser = subparsers.add_parser("export", parents=[common_sub], help="Export applications and enable the host tray bridge")
    export_parser.add_argument("apps", nargs="+", help="Application IDs to export (e.g. google-chrome org.kde.dolphin)")

    run_parser = subparsers.add_parser("run", help="Run a guest command directly via waypipe")
    run_parser.add_argument("cmd", nargs=argparse.REMAINDER, help="Guest command and arguments to run")

    subparsers.add_parser("tray-daemon", parents=[common_sub], help="Run the host-side System Tray & Notification bridge daemon")

    remove_parser = subparsers.add_parser("remove", parents=[common_sub], help="Remove exported applications from the host")
    remove_parser.add_argument("apps", nargs="*", help="Application IDs to remove")
    remove_parser.add_argument("--all", action="store_true", help="Remove all exported apps, icons, and tray service for this VM")

    install_guest_parser = subparsers.add_parser(
        "install-guest",
        parents=[common_sub],
        help="Install guest helper scripts and pure-VSOCK `wayport-guest.service`",
    )
    install_guest_parser.add_argument(
        "--local",
        action="store_true",
        help="Install locally inside the guest VM (no SSH required)",
    )

    subparsers.add_parser("doctor", parents=[common_sub], help="Check host & guest readiness for the selected transport mode")
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_arg_parser()
    args = parser.parse_args(argv)

    require_target = args.command not in ("doctor", "install-guest")
    if args.command == "install-guest" and not args.local:
        require_target = True

    try:
        cfg = build_runtime_config(
            mode=args.mode,
            vm_target=args.target,
            vsock_cid=args.cid,
            compression=args.compression,
            no_gpu=args.no_gpu,
            tray_port=args.tray_port,
            control_port=args.control_port,
            require_target=require_target,
        )
    except ValueError as exc:
        parser.error(str(exc))

    try:
        if args.command == "list":
            list_guest_applications(cfg)
            return 0
        if args.command == "export":
            export_applications(cfg, args.apps)
            return 0
        if args.command == "run":
            cmd_tokens = list(args.cmd)
            if cmd_tokens and cmd_tokens[0] == "--":
                cmd_tokens = cmd_tokens[1:]
            if not cmd_tokens:
                parser.error("`run` requires a guest command.")
            return run_guest_application(cfg, cmd_tokens, start_tray=not bool(getattr(args, "no_tray", False)))
        if args.command == "tray-daemon":
            run_host_tray_daemon(cfg)
            return 0
        if args.command == "remove":
            if not args.all and not args.apps:
                parser.error("Specify at least one app ID or use --all.")
            remove_applications(cfg, args.apps, args.all)
            return 0
        if args.command == "install-guest":
            install_guest_components(cfg, local=args.local)
            return 0
        if args.command == "doctor":
            return run_doctor(cfg)
    except BrokenPipeError:
        return 0
    except TransportError as exc:
        print(f"[ERROR] {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    sys.exit(main())
