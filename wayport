def serialize_pixmaps(raw_pixmaps) -> list[dict]:
    result = []
    if not raw_pixmaps:
        return result
    for item in raw_pixmaps:
        try:
            w, h, data = int(item[0]), int(item[1]), bytes(item[2])
            if w > 0 and h > 0 and data:
